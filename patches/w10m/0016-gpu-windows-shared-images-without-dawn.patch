From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Ilya Vysotsky <il.mohoff2016@yandex.ru>
Date: Fri, 9 Oct 2026 15:08:08 +0400
Subject: [PATCH] GPU: Windows shared images without Dawn

D3DImageBacking holds a DawnSharedTextureCache whether or not Dawn is
built, and its Dawn-only paths reference a few Dawn members. Without
skia_use_dawn the cache is built on its own and dawn_absent_win.cc
defines the rest as unreachable: they need a Dawn device or a
Graphite-Dawn context, which such a build never has.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 gpu/command_buffer/service/BUILD.gn           | 10 ++++++
 .../service/shared_image/dawn_absent_win.cc   | 31 +++++++++++++++++++
 2 files changed, 41 insertions(+)
 create mode 100644 gpu/command_buffer/service/shared_image/dawn_absent_win.cc

diff --git a/gpu/command_buffer/service/BUILD.gn b/gpu/command_buffer/service/BUILD.gn
index b35ca606a2cadf8c5421bca2460b05cdece1b3f5..34232e5cb41f55f5dd1a5ad9ee5a34b84997ad20 100644
--- a/gpu/command_buffer/service/BUILD.gn
+++ b/gpu/command_buffer/service/BUILD.gn
@@ -648,6 +648,16 @@ target(link_target_type, "gles2_sources") {
       "shared_image/dxgi_swap_chain_image_representation.cc",
       "shared_image/dxgi_swap_chain_image_representation.h",
     ]
+    if (!skia_use_dawn) {
+      # D3DImageBacking creates and holds a DawnSharedTextureCache whether
+      # or not Dawn is there; its Dawn-only paths reference a few more Dawn
+      # classes, which dawn_absent_win.cc stands in for.
+      sources += [
+        "shared_image/dawn_absent_win.cc",
+        "shared_image/dawn_shared_texture_cache.cc",
+        "shared_image/dawn_shared_texture_cache.h",
+      ]
+    }
     libs = [
       "d3d11.lib",
       "d3d12.lib",
diff --git a/gpu/command_buffer/service/shared_image/dawn_absent_win.cc b/gpu/command_buffer/service/shared_image/dawn_absent_win.cc
new file mode 100644
index 0000000000000000000000000000000000000000..43d376a60ee2dc0dd86556586fe1c4f06f151301
--- /dev/null
+++ b/gpu/command_buffer/service/shared_image/dawn_absent_win.cc
@@ -0,0 +1,31 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+// Windows without Dawn (use_dawn = false, skia_use_dawn = false), as on
+// Windows 10 Mobile, where no GPU could run it. D3DImageBacking's Dawn and
+// Graphite-Dawn paths still reference these members; they are reached only
+// with a Dawn device or a Graphite-Dawn context, neither of which exists in
+// such a build.
+
+#include <dawn/webgpu_cpp.h>
+
+#include "base/notreached.h"
+#include "gpu/command_buffer/service/dawn_context_provider.h"
+#include "gpu/command_buffer/service/shared_image/skia_graphite_dawn_image_representation.h"
+
+namespace gpu {
+
+wgpu::Device DawnContextProvider::GetDevice() const {
+  NOTREACHED();
+}
+
+SkiaGraphiteDawnImageRepresentation::~SkiaGraphiteDawnImageRepresentation() {
+  NOTREACHED();
+}
+
+wgpu::Device SkiaGraphiteDawnImageRepresentation::GetDevice() const {
+  NOTREACHED();
+}
+
+}  // namespace gpu
