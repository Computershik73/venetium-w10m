 constexpr bool kHintIsAdvisory = false;
 std::atomic<int32_t> s_allocPageErrorCode{ERROR_SUCCESS};
@@ -114,6 +284,25 @@ uintptr_t SystemAllocPagesInternal(
     PageTag page_tag,
     [[maybe_unused]] int file_descriptor_for_shared_alloc) {
   const DWORD access_flag = GetAccessFlags(accessibility);
+#if defined(VENETIUM_W10M)
+  if (access_flag == PAGE_EXECUTE_READWRITE ||
+      access_flag == PAGE_EXECUTE_READ) {
+    // Reserved, then committed as code (w10m_jit above).
+    void* base = VirtualAllocWithRetry(reinterpret_cast<void*>(hint), length,
+                                       MEM_RESERVE, PAGE_NOACCESS);
+    if (base && !(access_flag == PAGE_EXECUTE_READWRITE
+                      ? w10m_jit::MakeJit(base, length)
+                      : w10m_jit::MakeExecutable(base, length))) {
+      s_allocPageErrorCode = GetLastError();
+      VirtualFree(base, 0, MEM_RELEASE);
+      return 0;
+    }
+    if (!base) {
+      s_allocPageErrorCode = GetLastError();
+    }
+    return reinterpret_cast<uintptr_t>(base);
+  }
+#endif
   const DWORD type_flags =
       (access_flag == PAGE_NOACCESS) ? MEM_RESERVE : (MEM_RESERVE | MEM_COMMIT);
   void* ret = VirtualAllocWithRetry(reinterpret_cast<void*>(hint), length,
@@ -146,6 +335,15 @@ bool TrySetSystemPagesAccessInternal(
     size_t length,
     PageAccessibilityConfiguration accessibility) {
   void* ptr = reinterpret_cast<void*>(address);
+#if defined(VENETIUM_W10M)
+  w10m_jit::RemoveRange(address, length);
+  if (GetAccessFlags(accessibility) == PAGE_EXECUTE_READWRITE) {
+    return w10m_jit::MakeJit(ptr, length);
+  }
+  if (GetAccessFlags(accessibility) == PAGE_EXECUTE_READ) {
+    return w10m_jit::MakeExecutable(ptr, length);
+  }
+#endif
   if (GetAccessFlags(accessibility) == PAGE_NOACCESS) {
     return VirtualFree(ptr, length, MEM_DECOMMIT) != 0;
   }
@@ -162,6 +360,18 @@ void SetSystemPagesAccessInternal(
     PageAccessibilityConfiguration accessibility) {
   void* ptr = reinterpret_cast<void*>(address);
   const DWORD access_flag = GetAccessFlags(accessibility);
+#if defined(VENETIUM_W10M)
+  w10m_jit::RemoveRange(address, length);
+  if (access_flag == PAGE_EXECUTE_READWRITE ||
+      access_flag == PAGE_EXECUTE_READ) {
+    if (!(access_flag == PAGE_EXECUTE_READWRITE
+              ? w10m_jit::MakeJit(ptr, length)
+              : w10m_jit::MakeExecutable(ptr, length))) {
+      OOM_CRASH(length);
+    }
+    return;
+  }
+#endif
   if (access_flag == PAGE_NOACCESS) {
     if (!VirtualFree(ptr, length, MEM_DECOMMIT)) {
       // We check `GetLastError` for `ERROR_SUCCESS` here so that in a crash
@@ -183,6 +393,9 @@ void SetSystemPagesAccessInternal(
 }
 
 void FreePagesInternal(uintptr_t address, size_t length) {
+#if defined(VENETIUM_W10M)
+  w10m_jit::RemoveRange(address, length);
+#endif
   PA_CHECK(VirtualFree(reinterpret_cast<void*>(address), 0, MEM_RELEASE));
 }
 
@@ -208,6 +421,9 @@ bool DecommitAndZeroSystemPagesInternal(uintptr_t address,
   // https://docs.microsoft.com/en-us/windows/win32/api/memoryapi/nf-memoryapi-virtualalloc
   // for MEM_COMMIT: "The function also guarantees that when the caller later
   // initially accesses the memory, the contents will be zero."
+#if defined(VENETIUM_W10M)
+  w10m_jit::RemoveRange(address, length);
+#endif
   PA_CHECK(VirtualFree(reinterpret_cast<void*>(address), length, MEM_DECOMMIT));
   return true;
 }
