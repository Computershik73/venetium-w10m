 const char kPresetLiveRunForBetterAds[] =
     "liverun_on_better_ads_violating_sites";
 
@@ -315,6 +320,22 @@ Configuration Configuration::MakePresetForLiveRunForBetterAds() {
   return config;
 }
 
+// static
+// Venetium 0059: block the subresources matched by the ruleset Venetium ships
+// (EasyList + EasyPrivacy network rules, published at startup by
+// BrowserProcessImpl) on every site. Above every other preset, so it is the
+// configuration that decides. A site the user allows ads on (the "Ads" site
+// setting, or "Always allow ads on this site" in the blocked-ads bubble) is
+// not filtered; --disable-features=SubresourceFilter, or
+// SubresourceFilter:disable_presets/venetium_live_run_on_all_sites, turns the
+// blocker off.
+Configuration Configuration::MakePresetForVenetiumLiveRunOnAllSites() {
+  Configuration config(mojom::ActivationLevel::kEnabled,
+                       ActivationScope::ALL_SITES);
+  config.activation_conditions.priority = 2000;
+  return config;
+}
+
 Configuration::Configuration() = default;
 Configuration::Configuration(mojom::ActivationLevel activation_level,
                              ActivationScope activation_scope,
