+namespace {
+
+// Venetium 0059: the ad/tracker filter list Venetium ships next to the
+// executable: venetium_filters\filters.dat (an unindexed subresource_filter
+// ruleset built from EasyList + EasyPrivacy by ruleset_converter), version.txt
+// (the list's content version) and LICENSE.txt.
+base::FilePath VenetiumFiltersDir() {
+  base::FilePath exe_dir;
+  if (!base::PathService::Get(base::DIR_EXE, &exe_dir)) {
+    return base::FilePath();
+  }
+  return exe_dir.AppendASCII("venetium_filters");
+}
+
+std::string ReadVenetiumFiltersVersion(const base::FilePath& dir) {
+  std::string version;
+  if (dir.empty() ||
+      !base::PathExists(dir.AppendASCII("filters.dat")) ||
+      !base::ReadFileToStringWithMaxSize(dir.AppendASCII("version.txt"),
+                                         &version, 256)) {
+    return std::string();
+  }
+  return std::string(base::TrimWhitespaceASCII(version, base::TRIM_ALL));
+}
+
+// Indexes the list once per content version (RulesetService compares it with
+// the last indexed one, does the work on a background thread after startup,
+// and keeps publishing the stored indexed copy on later launches).
+void PublishVenetiumFilters(const base::FilePath& dir,
+                            const std::string& version) {
+  if (version.empty() || !g_browser_process) {
+    return;
+  }
+  subresource_filter::RulesetService* service =
+      g_browser_process->subresource_filter_ruleset_service();
+  if (!service) {
+    return;
+  }
+  subresource_filter::UnindexedRulesetInfo info;
+  info.content_version = "venetium-" + version;
+  info.ruleset_path = dir.AppendASCII("filters.dat");
+  info.license_path = dir.AppendASCII("LICENSE.txt");
+  service->IndexAndStoreAndPublishRulesetIfNeeded(info);
+}
+
+}  // namespace
+
 void BrowserProcessImpl::CreateSubresourceFilterRulesetService() {
   DCHECK(!subresource_filter_ruleset_service_);
   created_subresource_filter_ruleset_service_ = true;
@@ -1794,6 +1845,13 @@ void BrowserProcessImpl::CreateSubresourceFilterRulesetService() {
           subresource_filter::kSafeBrowsingRulesetConfig, local_state(),
           user_data_dir,
           subresource_filter::SafeBrowsingRulesetPublisher::Factory());
+
+  // Venetium 0059: publish the bundled filter list (see above).
+  const base::FilePath filters_dir = VenetiumFiltersDir();
+  base::ThreadPool::PostTaskAndReplyWithResult(
+      FROM_HERE, {base::MayBlock(), base::TaskPriority::BEST_EFFORT},
+      base::BindOnce(&ReadVenetiumFiltersVersion, filters_dir),
+      base::BindOnce(&PublishVenetiumFilters, filters_dir));
 }
 
