From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Ilya Vysotsky <il.mohoff2016@yandex.ru>
Date: Fri, 9 Oct 2026 15:08:08 +0400
Subject: [PATCH] Toolchain: sqlite's memory barrier without _ReadWriteBarrier
 (public rt2)

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 third_party/sqlite/BUILD.gn | 7 +++++++
 1 file changed, 7 insertions(+)

diff --git a/third_party/sqlite/BUILD.gn b/third_party/sqlite/BUILD.gn
index e148477e9825669ab7277615a5e768aa7d92c338..b2706ce2c86a9bbddc56f2dce5776e3962b1d346 100644
--- a/third_party/sqlite/BUILD.gn
+++ b/third_party/sqlite/BUILD.gn
@@ -63,6 +63,13 @@ config("common_sqlite3_compile_options") {
     defines += [ "SQLITE_ENABLE_LOCKING_STYLE=0" ]
   }
 
+  # clang-cl for 32-bit ARM Windows leaves _ReadWriteBarrier(), which
+  # sqlite3MemoryBarrier() uses under MSVC, an external nothing defines (with
+  # the public rt2 toolchain). A full fence instead; it is only stronger.
+  if (is_win && current_cpu == "arm") {
+    defines += [ "SQLITE_MEMORY_BARRIER=__atomic_thread_fence(5)" ]
+  }
+
   if (using_sanitizer) {
     defines += [
       # Limit max length of data blobs and queries to 64 MB for fuzzing builds.
