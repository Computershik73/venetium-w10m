@@ -302,6 +302,19 @@ using UsesKeyboardAccessoryForSuggestions =
 namespace {
 
 #if BUILDFLAG(ENABLE_PDF)
+// A renderer that shows PDFs and nothing else. Supermium's
+// pdf::IsPdfRenderer() says so of a single-process renderer too, which hosts
+// every page there is: on Windows 10 Mobile, where Chrome always runs in one
+// process, that left every page without DOM storage or the default CSP.
+bool IsPdfOnlyRenderer() {
+#if defined(VENETIUM_W10M)
+  return base::CommandLine::ForCurrentProcess()->HasSwitch(
+      switches::kPdfRenderer);
+#else
+  return pdf::IsPdfRenderer();
+#endif
