diff --git a/chrome/browser/metrics/chrome_browser_main_extra_parts_metrics.cc b/chrome/browser/metrics/chrome_browser_main_extra_parts_metrics.cc
index a5ecdd00d2ce8f66772912b651f3a38302ec79fd..d37c48fcbad41a231f85ac4223046970a3b02d2e 100644
--- a/chrome/browser/metrics/chrome_browser_main_extra_parts_metrics.cc
+++ b/chrome/browser/metrics/chrome_browser_main_extra_parts_metrics.cc
@@ -1108,7 +1108,12 @@ void ChromeBrowserMainExtraPartsMetrics::PostBrowserStart() {
                              base::BindOnce(&RecordLinuxDistro));
 #endif
 
-#if BUILDFLAG(IS_WIN)
+#if defined(VENETIUM_W10M)
+  // Not on Windows 10 Mobile: nobody reads these metrics (reporting is off
+  // in this build), and gathering them asks the shell which browser is the
+  // default, the registry for compatibility layers, WMI and the TPM -- a
+  // phone's CPU at start-up for nothing.
+#elif BUILDFLAG(IS_WIN)
   // RecordStartupMetrics calls into shell_integration::GetDefaultBrowser(),
   // which requires a COM thread on Windows.
   base::ThreadPool::CreateCOMSTATaskRunner(kBestEffortTaskTraits)
diff --git a/chrome/browser/platform_util.h b/chrome/browser/platform_util.h
index 3b223314d75e7a3f4f1aa215ed70505c0ac9dccd..424909f78991d5a3dc7718abc49109ff04313872 100644
--- a/chrome/browser/platform_util.h
+++ b/chrome/browser/platform_util.h
@@ -5,6 +5,8 @@
 #ifndef CHROME_BROWSER_PLATFORM_UTIL_H_
 #define CHROME_BROWSER_PLATFORM_UTIL_H_
 
+#include <string>
+
 #include "base/functional/callback_forward.h"
 #include "build/build_config.h"
 #include "chrome/common/buildflags.h"
@@ -83,6 +85,17 @@ void OpenExternal(Profile* profile, const GURL& url);
 void OpenExternal(const GURL& url);
 #endif
 
+#if defined(VENETIUM_W10M)
+// Windows 10 Mobile has no ShellExecute and no Explorer: the app's shell
+// opens what Chrome hands out -- a URL of another app's (mailto:, tel:,
+// ms-settings:), a downloaded file, the folder a download is in -- through
+// the Windows Runtime launcher. The embedder sets the handler, which may be
+// called on any thread; with none set, nothing is opened.
+enum class W10mOpen { kUrl, kFile, kFolder };
+using W10mOpenHandler = void (*)(W10mOpen what, const std::string& target);
+void SetW10mOpenHandler(W10mOpenHandler handler);
+#endif
+
 // Get the top level window for the native view. This can return NULL.
 gfx::NativeWindow GetTopLevel(gfx::NativeView view);
 
diff --git a/chrome/browser/platform_util_win.cc b/chrome/browser/platform_util_win.cc
index 3b1c0fddde6841188a1f5ccecd44132fe5fd3ba9..54361f85b21c80c658fa713096d735112bc4bfc3 100644
--- a/chrome/browser/platform_util_win.cc
+++ b/chrome/browser/platform_util_win.cc
@@ -36,6 +36,18 @@ namespace platform_util {
 
 namespace {
 
+#if defined(VENETIUM_W10M)
+W10mOpenHandler g_w10m_open = nullptr;
+
+void HandToShell(W10mOpen what, const std::string& target) {
+  if (g_w10m_open) {
+    g_w10m_open(what, target);
+  } else {
+    LOG(WARNING) << "Nothing opens " << target;
+  }
+}
+#endif
+
 void ShowItemInFolderOnWorkerThread(const base::FilePath& full_path) {
   base::ScopedBlockingCall scoped_blocking_call(FROM_HERE,
                                                 base::BlockingType::MAY_BLOCK);
@@ -116,7 +128,17 @@ void OpenExternalOnWorkerThread(const GURL& url) {
 
 }  // namespace
 
+#if defined(VENETIUM_W10M)
+void SetW10mOpenHandler(W10mOpenHandler handler) {
+  g_w10m_open = handler;
+}
+#endif
+
 void ShowItemInFolder(Profile* profile, const base::FilePath& full_path) {
+#if defined(VENETIUM_W10M)
+  HandToShell(W10mOpen::kFolder, full_path.DirName().AsUTF8Unsafe());
+  return;
+#endif
   base::ThreadPool::CreateCOMSTATaskRunner(
       {base::MayBlock(), base::TaskPriority::USER_BLOCKING})
       ->PostTask(FROM_HERE,
@@ -131,11 +153,19 @@ void PlatformOpenVerifiedItem(const base::FilePath& path, OpenItemType type) {
                                                 base::BlockingType::MAY_BLOCK);
   switch (type) {
     case OPEN_FILE:
+#if defined(VENETIUM_W10M)
+      HandToShell(W10mOpen::kFile, path.AsUTF8Unsafe());
+#else
       ui::win::OpenFileViaShell(path);
+#endif
       break;
 
     case OPEN_FOLDER:
+#if defined(VENETIUM_W10M)
+      HandToShell(W10mOpen::kFolder, path.AsUTF8Unsafe());
+#else
       ui::win::OpenFolderViaShell(path);
+#endif
       break;
   }
 }
@@ -144,6 +174,10 @@ void PlatformOpenVerifiedItem(const base::FilePath& path, OpenItemType type) {
 
 void OpenExternal(const GURL& url) {
   DCHECK_CURRENTLY_ON(BrowserThread::UI);
+#if defined(VENETIUM_W10M)
+  HandToShell(W10mOpen::kUrl, url.spec());
+  return;
+#endif
 
   base::ThreadPool::CreateCOMSTATaskRunner(
       {base::MayBlock(), base::TaskPriority::USER_BLOCKING})
diff --git a/chrome/browser/prefs/incognito_mode_prefs.cc b/chrome/browser/prefs/incognito_mode_prefs.cc
index 1760e5e9568cd99d6354f28061e8b50d24141d7c..e4f1a71fedeafe6b98028530fcef4165e88b28d9 100644
