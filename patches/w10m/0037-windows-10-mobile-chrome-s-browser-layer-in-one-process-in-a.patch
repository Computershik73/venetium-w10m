       policy::policy_prefs::kIncognitoModeAvailability);
   IncognitoModeAvailability result = kDefaultAvailability;
@@ -137,6 +144,7 @@ IncognitoModeAvailability IncognitoModePrefs::GetAvailabilityInternal(
     return IncognitoModeAvailability::kDisabled;
   }
   return result;
+#endif  // defined(VENETIUM_W10M)
 }
 
