diff --git a/chrome/browser/ui/views/status_icons/status_tray_win.cc b/chrome/browser/ui/views/status_icons/status_tray_win.cc
index 747c77d6f34f2f04e7722a3f27beabfc643a044f..00ebb468d1ead2719ebd169c8e034ab56d4f8184 100644
--- a/chrome/browser/ui/views/status_icons/status_tray_win.cc
+++ b/chrome/browser/ui/views/status_icons/status_tray_win.cc
@@ -242,12 +242,42 @@ void StatusTrayWin::SetStatusTrayStateChangerProxyForTest(
   state_changer_proxy_ = std::move(proxy);
 }
 
+#if defined(VENETIUM_W10M)
+namespace {
+
+// Windows 10 Mobile has no notification area, and StatusTrayWin CHECKs the
+// window class it cannot register there. Chrome still gets a tray and its
+// icons -- several owners take them for granted (the WebUSB and WebHID
+// device icons, Glic's) -- which show nowhere.
+class StatusIconW10m : public StatusIcon {
+ public:
+  void SetImage(const gfx::ImageSkia& image) override {}
+  void SetToolTip(const std::u16string& tool_tip) override {}
+  void DisplayBalloon(const gfx::ImageSkia& icon,
+                      const std::u16string& title,
+                      const std::u16string& contents,
+                      const message_center::NotifierId& notifier_id) override {}
+
+ protected:
+  void UpdatePlatformContextMenu(StatusIconMenuModel* model) override {}
+};
+
+class StatusTrayW10m : public StatusTray {
+ protected:
+  std::unique_ptr<StatusIcon> CreatePlatformStatusIcon(
+      StatusTray::StatusIconType type,
+      const gfx::ImageSkia& image,
+      const std::u16string& tool_tip) override {
+    return std::make_unique<StatusIconW10m>();
+  }
+};
+
+}  // namespace
+#endif  // defined(VENETIUM_W10M)
+
 std::unique_ptr<StatusTray> StatusTray::Create() {
 #if defined(VENETIUM_W10M)
-  // Windows 10 Mobile has no notification area, and StatusTrayWin CHECKs
-  // the window class it cannot register there. Chrome goes without a tray,
-  // as on Android.
-  return nullptr;
+  return std::make_unique<StatusTrayW10m>();
 #else
   return std::make_unique<StatusTrayWin>();
 #endif
