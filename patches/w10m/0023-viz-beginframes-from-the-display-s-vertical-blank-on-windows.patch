+// Copyright 2026 The Venetium-W10M Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef COMPONENTS_VIZ_SERVICE_FRAME_SINKS_EXTERNAL_BEGIN_FRAME_SOURCE_W10M_H_
+#define COMPONENTS_VIZ_SERVICE_FRAME_SINKS_EXTERNAL_BEGIN_FRAME_SOURCE_W10M_H_
+
+#include <memory>
+
+#include "base/memory/scoped_refptr.h"
+#include "base/memory/weak_ptr.h"
+#include "base/task/sequenced_task_runner.h"
+#include "base/time/time.h"
+#include "base/timer/timer.h"
+#include "components/viz/common/frame_sinks/begin_frame_source.h"
+#include "components/viz/service/viz_service_export.h"
+
+namespace viz {
+
+// Windows 10 Mobile (Venetium): BeginFrames from the display's own vertical
+// blank.
+//
+// Without DirectComposition viz on Windows ticks from a millisecond timer
+// (DelayBasedBeginFrameSource). On a phone that timer is coarse -- base asks
+// for an 8 ms timer period on battery -- and steering its timebase cannot
+// put frames in step with the panel. ExternalBeginFrameSourceWin, which
+// would do it, finds its output through MonitorFromWindow and its interval
+// through DWM, and a phone has neither.
+//
+// So a thread here waits on the adapter's first output (the phone's panel)
+// with IDXGIOutput::WaitForVBlank, as gecko-w10m's vsync source does, and
+// every blank is a BeginFrame on the viz sequence: its time a steady grid
+// kept to the blank, its interval the measured one. The thread sleeps while
+// nobody wants frames. Where the display gives no blank to wait for (it is
+// off, or the output went away) the thread ticks from a timer instead, and
+// if the wait itself never returns a watchdog here does, so frames never
+// stop for good.
+class VIZ_SERVICE_EXPORT ExternalBeginFrameSourceW10m
+    : public ExternalBeginFrameSource,
+      public ExternalBeginFrameSourceClient {
+ public:
+  // Null if the thread cannot be started: the caller keeps its timer then.
+  static std::unique_ptr<ExternalBeginFrameSourceW10m> Create(
+      uint32_t restart_id,
+      scoped_refptr<base::SequencedTaskRunner> task_runner);
+
+  ExternalBeginFrameSourceW10m(const ExternalBeginFrameSourceW10m&) = delete;
+  ExternalBeginFrameSourceW10m& operator=(const ExternalBeginFrameSourceW10m&) =
+      delete;
+
+  ~ExternalBeginFrameSourceW10m() override;
+
+  // ExternalBeginFrameSource implementation.
+  BeginFrameArgs GetMissedBeginFrameArgs(BeginFrameObserver* obs) override;
+
+  // ExternalBeginFrameSourceClient implementation.
+  void OnNeedsBeginFrames(bool needs_begin_frames) override;
+
+ private:
+  // What this and the vblank thread share; the thread keeps it alive.
+  class Core;
+
+  ExternalBeginFrameSourceW10m(
+      uint32_t restart_id,
+      scoped_refptr<base::SequencedTaskRunner> task_runner);
+
+  // The vblank thread has a tick (posted from it).
+  void OnTick();
+  void IssueBeginFrame(base::TimeTicks frame_time, base::TimeDelta interval);
+
+  // Every quarter of a second while frames are wanted: has there been a
+  // tick? While there is none, this is the tick.
+  void ArmWatchdog();
+  void OnWatchdog();
+
+  scoped_refptr<base::SequencedTaskRunner> task_runner_;
+  scoped_refptr<Core> core_;
+
+  BeginFrameArgsGenerator begin_frame_args_generator_;
+
+  bool needs_begin_frames_ = false;
+  base::TimeDelta interval_ = BeginFrameArgs::DefaultInterval();
+
+  base::DeadlineTimer watchdog_;
+  base::TimeTicks watchdog_armed_;
+  base::TimeDelta watchdog_period_;
+  bool ticked_ = false;
+  bool stalled_ = false;
+  bool stall_noted_ = false;
+  int stall_notes_left_ = 6;
+
+  base::WeakPtrFactory<ExternalBeginFrameSourceW10m> weak_factory_{this};
+};
+
+}  // namespace viz
+
+#endif  // COMPONENTS_VIZ_SERVICE_FRAME_SINKS_EXTERNAL_BEGIN_FRAME_SOURCE_W10M_H_
