+// The number of tabs in a rounded square, as Chrome for Android's tab
+// switcher button. It opens the list of tabs (tab search, anchored here).
+class PhoneTabCounterButton : public ToolbarButton,
+                              public TabStripModelObserver {
+  METADATA_HEADER(PhoneTabCounterButton, ToolbarButton)
+
+ public:
+  explicit PhoneTabCounterButton(Browser* browser) : browser_(browser) {
+    tab_search_ = std::make_unique<TabSearchBubbleHost>(this, browser);
+    SetTooltipText(l10n_util::GetStringUTF16(IDS_ACCNAME_TAB_SEARCH));
+    GetViewAccessibility().SetName(
+        l10n_util::GetStringUTF16(IDS_ACCNAME_TAB_SEARCH));
+    browser_->tab_strip_model()->AddObserver(this);
+    Count();
+  }
+  PhoneTabCounterButton(const PhoneTabCounterButton&) = delete;
+  PhoneTabCounterButton& operator=(const PhoneTabCounterButton&) = delete;
+  ~PhoneTabCounterButton() override = default;
+
+  // TabStripModelObserver:
+  void OnTabStripModelChanged(
+      TabStripModel* tab_strip_model,
+      const TabStripModelChange& change,
+      const TabStripSelectionChange& selection) override {
+    Count();
+  }
+
+  // ToolbarButton:
+  gfx::Size CalculatePreferredSize(
+      const views::SizeBounds& available_size) const override {
+    const int extent =
+        GetLayoutConstant(LayoutConstant::kToolbarButtonHeight);
+    return gfx::Size(extent, extent);
+  }
+  void PaintButtonContents(gfx::Canvas* canvas) override {
+    const ui::ColorProvider* colors = GetColorProvider();
+    if (!colors) {
+      return;
+    }
+    const SkColor color = colors->GetColor(kColorToolbarButtonIcon);
+    const float side = std::min(width(), height()) * 0.45f;
+    const gfx::RectF box((width() - side) / 2, (height() - side) / 2, side,
+                         side);
+    cc::PaintFlags flags;
+    flags.setAntiAlias(true);
+    flags.setStyle(cc::PaintFlags::kStroke_Style);
+    flags.setStrokeWidth(2);
+    flags.setColor(color);
+    canvas->DrawRoundRect(box, side / 5, flags);
+    const gfx::FontList font = gfx::FontList().DeriveWithSizeDelta(
+        static_cast<int>(side * 0.55f) - gfx::FontList().GetFontSize())
+                                   .DeriveWithWeight(gfx::Font::Weight::BOLD);
+    canvas->DrawStringRectWithFlags(text_, font, color,
+                                    gfx::ToEnclosingRect(box),
+                                    gfx::Canvas::TEXT_ALIGN_CENTER);
+  }
+
+ private:
+  void Count() {
+    const int count = browser_->tab_strip_model()->count();
+    // Chrome for Android's face for a hundred tabs and more.
+    text_ = count < 100 ? base::NumberToString16(count) : u":D";
+    SchedulePaint();
+  }
+
+  raw_ptr<Browser> browser_;
+  std::unique_ptr<TabSearchBubbleHost> tab_search_;
+  std::u16string text_;
+};
+
+BEGIN_METADATA(PhoneTabCounterButton)
+END_METADATA
