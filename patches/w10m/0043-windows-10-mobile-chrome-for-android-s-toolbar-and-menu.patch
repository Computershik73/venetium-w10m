+// PhoneNavigationView ---------------------------------------------------------
+
+// Chrome for Android's first menu row: back, forward, bookmark, download and
+// reload, as round icon buttons spread across the menu.
+class AppMenu::PhoneNavigationView : public AppMenuView {
+  METADATA_HEADER(PhoneNavigationView, AppMenuView)
+
+ public:
+  PhoneNavigationView(AppMenu* menu, ButtonMenuItemModel* menu_model)
+      : AppMenuView(menu, menu_model) {
+    static constexpr int kNames[] = {
+        IDS_CONTENT_CONTEXT_BACK, IDS_CONTENT_CONTEXT_FORWARD,
+        IDS_STAR_VIEW_MENU_ADD_BOOKMARK, IDS_SAVE_PAGE,
+        IDS_CONTENT_CONTEXT_RELOAD};
+    const gfx::VectorIcon* const icons[] = {
+        &vector_icons::kArrowBackIcon, &vector_icons::kArrowForwardIcon,
+        &kStarIcon, &kDownloadIcon, &vector_icons::kRefreshIcon};
+    const auto cancel_and_evaluate =
+        [](AppMenu* menu, ButtonMenuItemModel* menu_model, size_t index) {
+          menu->CancelAndEvaluate(menu_model, index);
+        };
+    const size_t count =
+        std::min<size_t>(menu_model->GetItemCount(), std::size(icons));
+    for (size_t i = 0; i < count; ++i) {
+      CreateButtonWithAccessibleName(
+          base::BindRepeating(cancel_and_evaluate, base::Unretained(menu),
+                              menu_model, i),
+          kNames[i], InMenuButtonBackground::ButtonType::kRoundedButton, i,
+          kNames[i], /*add_accelerator_text=*/false,
+          /*use_accessible_name_as_tooltip_text=*/true, *icons[i]);
+    }
+  }
+  PhoneNavigationView(const PhoneNavigationView&) = delete;
+  PhoneNavigationView& operator=(const PhoneNavigationView&) = delete;
+
+  // Overridden from View.
+  gfx::Size CalculatePreferredSize(
+      const views::SizeBounds& available_size) const override {
+    // The height is the menu item's.
+    return {kButtonExtent * static_cast<int>(children().size()), 0};
+  }
+
+  void Layout(PassKey) override {
+    // As many equal columns as there are buttons, each holding a round
+    // button of its own size.
+    const int count = static_cast<int>(children().size());
+    if (!count) {
+      return;
+    }
+    const int column = width() / count;
+    const int extent = std::min({kButtonExtent, column, height()});
+    for (int i = 0; i < count; ++i) {
+      children()[i]->SetBounds(i * column + (column - extent) / 2,
+                               (height() - extent) / 2, extent, extent);
+    }
+  }
+
+ private:
+  static constexpr int kButtonExtent = 48;
+};
+
+BEGIN_METADATA(AppMenu, PhoneNavigationView)
+END_METADATA
+#endif  // defined(VENETIUM_W10M)
