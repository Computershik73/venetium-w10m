+// Chrome for Android's menu on a phone, as near as Chrome's commands come:
+// back, forward, bookmark, download and reload in a row of icons; then a new
+// tab; history and clearing it; downloads, bookmarks and recent tabs;
+// settings and help; and the shell's own. Incognito is not here: one
+// process serves one profile's storage.
+void AppMenuModel::BuildPhoneMenu() {
+  phone_navigation_model_ =
+      std::make_unique<ui::ButtonMenuItemModel>(IDS_CONTENT_CONTEXT_BACK, this);
+  phone_navigation_model_->AddGroupItemWithStringId(IDC_BACK,
+                                                    IDS_CONTENT_CONTEXT_BACK);
+  phone_navigation_model_->AddGroupItemWithStringId(
+      IDC_FORWARD, IDS_CONTENT_CONTEXT_FORWARD);
+  phone_navigation_model_->AddGroupItemWithStringId(
+      IDC_BOOKMARK_THIS_TAB, IDS_STAR_VIEW_MENU_ADD_BOOKMARK);
+  phone_navigation_model_->AddGroupItemWithStringId(IDC_SAVE_PAGE,
+                                                    IDS_SAVE_PAGE);
+  phone_navigation_model_->AddGroupItemWithStringId(IDC_RELOAD,
+                                                    IDS_CONTENT_CONTEXT_RELOAD);
+  AddButtonItem(kW10mNavigationRow, phone_navigation_model_.get());
+
+  AddItemWithStringIdAndVectorIcon(this, IDC_NEW_TAB, IDS_NEW_TAB, kAddIcon);
+  AddSeparator(ui::NORMAL_SEPARATOR);
+
+  AddItemWithStringIdAndVectorIcon(this, IDC_SHOW_HISTORY, IDS_HISTORY_MENU,
+                                   kHistoryIcon);
+  AddItemWithStringIdAndVectorIcon(this, IDC_CLEAR_BROWSING_DATA,
+                                   IDS_CLEAR_BROWSING_DATA, kDeleteIcon);
+  AddSeparator(ui::NORMAL_SEPARATOR);
+
+  AddItemWithStringIdAndVectorIcon(this, IDC_SHOW_DOWNLOADS,
+                                   IDS_SHOW_DOWNLOADS, kDownloadIcon);
+  AddItemWithStringIdAndVectorIcon(this, IDC_SHOW_BOOKMARK_MANAGER,
+                                   IDS_BOOKMARKS_AND_LISTS_MENU, kStarIcon);
+  auto recent_tabs = std::make_unique<RecentTabsSubMenuModel>(provider_,
+                                                              browser_);
+  recent_tabs->RegisterLogMenuMetricsCallback(base::BindRepeating(
+      &AppMenuModel::LogMenuMetrics, base::Unretained(this)));
+  sub_menus_.push_back(std::move(recent_tabs));
+  AddSubMenuWithStringIdAndVectorIcon(this, IDC_RECENT_TABS_MENU,
+                                      IDS_RECENT_TABS_MENU,
+                                      sub_menus_.back().get(), kDevicesIcon);
+  AddSeparator(ui::NORMAL_SEPARATOR);
+
+  AddItemWithStringIdAndVectorIcon(this, IDC_OPTIONS, IDS_SETTINGS,
+                                   kSettingsIcon);
+  AddItemWithStringIdAndVectorIcon(this, IDC_HELP_PAGE_VIA_MENU,
+                                   IDS_HELP_PAGE, kHelpCustomIcon);
+  AddSeparator(ui::NORMAL_SEPARATOR);
+
+  // The app's shell has an About, a log and engine switches of its own.
+  auto shell = std::make_unique<ui::SimpleMenuModel>(this);
+  shell->AddItem(kW10mShellCommandFirst, u"About this port");
+  shell->AddItem(kW10mShellCommandFirst + 1, u"Log");
+  shell->AddItem(kW10mShellCommandFirst + 2, u"Engine switches (restart)");
+  shell->AddItem(kW10mShellCommandFirst + 3, u"Copy logs to Pictures");
+  sub_menus_.push_back(std::move(shell));
+  AddSubMenu(kW10mShellSubmenu, u"Windows 10 Mobile", sub_menus_.back().get());
+}
