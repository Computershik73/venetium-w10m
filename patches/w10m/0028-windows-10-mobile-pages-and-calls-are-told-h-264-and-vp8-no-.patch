   if (config.hasDescription()) {
diff --git a/third_party/blink/renderer/platform/peerconnection/video_codec_factory.cc b/third_party/blink/renderer/platform/peerconnection/video_codec_factory.cc
index e958c0b2c102dc06ddc443c26dc203326f87ccd6..acaac30a6220801927090ee3eaa231bca65d01aa 100644
--- a/third_party/blink/renderer/platform/peerconnection/video_codec_factory.cc
+++ b/third_party/blink/renderer/platform/peerconnection/video_codec_factory.cc
@@ -32,6 +32,14 @@
 #include "media/base/android/media_codec_util.h"
 #endif
 
+#if defined(VENETIUM_W10M)
+#include <algorithm>
+
+#include "base/logging.h"
+#include "media/base/video_codecs_w10m.h"
+#include "third_party/webrtc/media/base/media_constants.h"
+#endif
+
 namespace blink {
 
 namespace {
@@ -83,6 +91,49 @@ std::unique_ptr<webrtc::VideoDecoder> Wrap(
   return software_decoder;
 }
 
+#if defined(VENETIUM_W10M)
+// Calls in H.264, with VP8 for a peer that has no H.264. WebRTC would also
+// offer VP9 and AV1, and a site that is offered them takes them: the two
+// heaviest to decode and to encode on a CPU, which is all a call has here.
+// SDP, getCapabilities() and MediaCapabilities' "webrtc" answers all ask
+// the two adapters below, so every one of them says the same.
+// "--vw-codecs=all" among the engine switches lifts this, for comparing on
+// a device.
+bool VwEveryCodec() {
+  static const bool every_codec = [] {
+    const bool all = media::W10mEveryVideoCodec();
+    LOG(WARNING) << "calls: video in "
+                 << (all ? "every codec WebRTC has"
+                         : "H.264, then VP8; no VP9, no AV1");
+    return all;
+  }();
+  return every_codec;
+}
+
+bool VwIsH264(const webrtc::SdpVideoFormat& format) {
+  return base::EqualsCaseInsensitiveASCII(format.name, webrtc::kH264CodecName);
+}
+
+bool VwCodecAllowed(const webrtc::SdpVideoFormat& format) {
+  return VwEveryCodec() || VwIsH264(format) ||
+         base::EqualsCaseInsensitiveASCII(format.name, webrtc::kVp8CodecName);
+}
+
+// What a factory lists, less what is left out, H.264 first: the order is the
+// order of preference in an offer, and the other side sends the first of
+// them it has.
+std::vector<webrtc::SdpVideoFormat> VwAllowedFormats(
+    std::vector<webrtc::SdpVideoFormat> formats) {
+  if (!VwEveryCodec()) {
+    std::erase_if(formats, [](const webrtc::SdpVideoFormat& format) {
+      return !VwCodecAllowed(format);
+    });
+    std::stable_partition(formats.begin(), formats.end(), VwIsH264);
+  }
+  return formats;
+}
+#endif  // defined(VENETIUM_W10M)
+
 // This class combines a hardware factory with the internal factory and adds
 // internal SW codecs, simulcast, and SW fallback wrappers.
 class EncoderAdapter : public webrtc::VideoEncoderFactory {
@@ -105,6 +156,11 @@ class EncoderAdapter : public webrtc::VideoEncoderFactory {
       LOG(ERROR) << "Unsupported SDP format: " << format.name;
       return nullptr;
     }
+#if defined(VENETIUM_W10M)
+    if (!VwCodecAllowed(format)) {
+      return nullptr;
+    }
+#endif
     const bool supported_in_hardware =
         IsFormatSupported(hardware_encoder_factory_.get(), format);
     bool allow_h264_profile_fallback = false;
@@ -147,16 +203,30 @@ class EncoderAdapter : public webrtc::VideoEncoderFactory {
   std::vector<webrtc::SdpVideoFormat> GetSupportedFormats() const override {
     std::vector<webrtc::SdpVideoFormat> software_formats =
         software_encoder_factory_.GetSupportedFormats();
+#if defined(VENETIUM_W10M)
+    if (hardware_encoder_factory_) {
+      software_formats =
+          MergeFormats(std::move(software_formats),
+                       hardware_encoder_factory_->GetSupportedFormats());
+    }
+    return VwAllowedFormats(std::move(software_formats));
+#else
     return hardware_encoder_factory_
                ? MergeFormats(software_formats,
                               hardware_encoder_factory_->GetSupportedFormats())
                : software_formats;
+#endif
   }
 
   webrtc::VideoEncoderFactory::CodecSupport QueryCodecSupport(
       const webrtc::SdpVideoFormat& format,
       std::optional<std::string> scalability_mode,
       std::optional<webrtc::Resolution> resolution) const override {
+#if defined(VENETIUM_W10M)
+    if (!VwCodecAllowed(format)) {
+      return webrtc::VideoEncoderFactory::CodecSupport();
+    }
+#endif
     webrtc::VideoEncoderFactory::CodecSupport codec_support =
         hardware_encoder_factory_
             ? hardware_encoder_factory_->QueryCodecSupport(
@@ -188,6 +258,11 @@ class DecoderAdapter : public webrtc::VideoDecoderFactory {
   std::unique_ptr<webrtc::VideoDecoder> Create(
       const webrtc::Environment& env,
       const webrtc::SdpVideoFormat& format) override {
+#if defined(VENETIUM_W10M)
+    if (!VwCodecAllowed(format)) {
+      return nullptr;
+    }
+#endif
     std::unique_ptr<webrtc::VideoDecoder> software_decoder =
         CreateDecoder(&software_decoder_factory_, env, format);
 
@@ -206,16 +281,30 @@ class DecoderAdapter : public webrtc::VideoDecoderFactory {
   std::vector<webrtc::SdpVideoFormat> GetSupportedFormats() const override {
     std::vector<webrtc::SdpVideoFormat> software_formats =
         software_decoder_factory_.GetSupportedFormats();
+#if defined(VENETIUM_W10M)
+    if (hardware_decoder_factory_) {
+      software_formats =
+          MergeFormats(std::move(software_formats),
+                       hardware_decoder_factory_->GetSupportedFormats());
+    }
+    return VwAllowedFormats(std::move(software_formats));
+#else
     return hardware_decoder_factory_
                ? MergeFormats(software_formats,
                               hardware_decoder_factory_->GetSupportedFormats())
                : software_formats;
+#endif
   }
 
   webrtc::VideoDecoderFactory::CodecSupport QueryCodecSupport(
       const webrtc::SdpVideoFormat& format,
       bool reference_scaling,
       std::optional<webrtc::Resolution> resolution) const override {
+#if defined(VENETIUM_W10M)
+    if (!VwCodecAllowed(format)) {
+      return webrtc::VideoDecoderFactory::CodecSupport();
+    }
+#endif
     webrtc::VideoDecoderFactory::CodecSupport codec_support =
         hardware_decoder_factory_
             ? hardware_decoder_factory_->QueryCodecSupport(
