@@ -447,6 +447,16 @@ VideoDecoder::MakeMediaVideoDecoderConfigInternal(
   if (video_type.codec == media::VideoCodec::kUnknown) {
     return std::nullopt;
   }
+#if defined(VENETIUM_W10M)
