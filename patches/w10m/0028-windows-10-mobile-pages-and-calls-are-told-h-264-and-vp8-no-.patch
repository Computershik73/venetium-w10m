+++ b/media/filters/ffmpeg_demuxer.cc
@@ -1317,6 +1317,10 @@ void FFmpegDemuxer::OnFindStreamInfoDone(int result) {
   int supported_audio_track_count = 0;
   int supported_video_track_count = 0;
   bool has_opus_or_vorbis_audio = false;
+#if defined(VENETIUM_W10M)
+  bool has_video_stream = false;
+  bool refused_video_stream = false;
+#endif
   const base::span<AVStream*> stream_span =
       AVFormatContextToSpan(format_context);
   for (size_t i = 0; i < stream_span.size(); ++i) {
@@ -1376,6 +1380,23 @@ void FFmpegDemuxer::OnFindStreamInfoDone(int result) {
     // things like: codec, channel layout, sample/pixel format, etc...
     std::unique_ptr<FFmpegDemuxerStream> demuxer_stream =
         FFmpegDemuxerStream::Create(this, stream, media_log_);
+#if defined(VENETIUM_W10M)
+    if (codec_type == AVMEDIA_TYPE_VIDEO) {
+      if (demuxer_stream) {
+        has_video_stream = true;
+      } else if (codec_id == AV_CODEC_ID_VP9 || codec_id == AV_CODEC_ID_AV1) {
+        // Skipped because the embedder refuses the codec itself, in its
+        // plainest form, and not for a profile libvpx or dav1d lack?
+        const bool vp9 = codec_id == AV_CODEC_ID_VP9;
+        if (!IsDecoderSupportedVideoType(
+                {vp9 ? VideoCodec::kVP9 : VideoCodec::kAV1,
+                 vp9 ? VP9PROFILE_PROFILE0 : AV1PROFILE_PROFILE_MAIN,
+                 kNoVideoCodecLevel, VideoColorSpace::REC709()})) {
+          refused_video_stream = true;
+        }
+      }
+    }
+#endif
     if (demuxer_stream.get()) {
       streams_[i] = std::move(demuxer_stream);
     } else {
@@ -1489,6 +1510,20 @@ void FFmpegDemuxer::OnFindStreamInfoDone(int result) {
       has_opus_or_vorbis_audio = is_opus_or_vorbis;
   }
 
+#if defined(VENETIUM_W10M)
+  // A file whose only picture is VP9 or AV1, which the embedder refuses on
+  // this phone, is not played as its sound over a blank frame (upstream's
+  // partial playback): the load fails, as in a browser without the codec,
+  // and a <source> list goes on to its next entry -- the MP4, usually.
+  if (refused_video_stream && !has_video_stream) {
+    MEDIA_LOG(ERROR, media_log_)
+        << GetDisplayName() << ": the video is VP9 or AV1, not decoded here";
+    LOG(WARNING) << "media: a file whose picture is VP9 or AV1 is not played";
+    RunInitCB(DEMUXER_ERROR_NO_SUPPORTED_STREAMS);
+    return;
+  }
+#endif
+
   if (media_tracks->tracks().empty()) {
     MEDIA_LOG(ERROR, media_log_) << GetDisplayName()
                                  << ": no supported streams";
