+  # Venetium 0060: no automatic stack-variable initialization in these DSP
+  # kernels (fixed-size scratch arrays they overwrite in full; the pattern/zero
+  # fill costs a memset per block). Same opt-out as libaom and V8.
+  configs -= [ "//build/config/compiler:default_init_stack_vars" ]
   configs -= [
     "//build/config/compiler:chromium_code",
 
@@ -220,6 +228,10 @@ static_library("dav1d_10bit") {
 
 if (current_cpu == "x86" || current_cpu == "x64") {
   static_library("dav1d_x86") {
+    # Venetium 0060: no automatic stack-variable initialization in these DSP
+    # kernels (fixed-size scratch arrays they overwrite in full; the pattern/zero
+    # fill costs a memset per block). Same opt-out as libaom and V8.
+    configs -= [ "//build/config/compiler:default_init_stack_vars" ]
     sources = [
       "libdav1d/src/x86/cpu.c",
       "libdav1d/src/x86/cpu.h",
@@ -238,6 +250,10 @@ if (current_cpu == "x86" || current_cpu == "x64") {
 } else if (current_cpu == "arm" || current_cpu == "arm64" ||
            current_cpu == "arm64e") {
   static_library("dav1d_arm") {
+    # Venetium 0060: no automatic stack-variable initialization in these DSP
+    # kernels (fixed-size scratch arrays they overwrite in full; the pattern/zero
+    # fill costs a memset per block). Same opt-out as libaom and V8.
+    configs -= [ "//build/config/compiler:default_init_stack_vars" ]
     sources = [
       "libdav1d/src/arm/cpu.c",
       "libdav1d/src/arm/cpu.h",
