@@ -142,6 +171,39 @@ angle::Result Clear11::ShaderManager::getShadersAndLayout(const gl::Context *con
 {
     Context11 *context11 = GetImplAs<Context11>(context);
 
+#if defined(ANGLE_ENABLE_WINDOWS_UWP) || defined(VENETIUM_W10M)
+    // GeckoW10m: at feature level 9_3 only the level 9 shaders can be created. ES 2 clears only
