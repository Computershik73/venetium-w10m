From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Ilya Vysotsky <il.mohoff2016@yandex.ru>
Date: Fri, 9 Oct 2026 09:12:53 +0400
Subject: [PATCH] viz: software frames to the embedder on Windows 10 Mobile

There is no HWND on Windows 10 Mobile for a software output device to draw
into: the engine is a UWP app whose browser window is an aura host with no
native window. VENETIUM_W10M builds ask a factory the embedder installs
(SetW10mSoftwareOutputDeviceFactory) for the device of every root surface;
the embedder's device publishes each frame to the app's XAML view.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 components/viz/service/BUILD.gn               |  1 +
 .../output_surface_provider_impl.cc           | 31 ++++++++++++++++++
 .../w10m_software_output_device.h             | 32 +++++++++++++++++++
 3 files changed, 64 insertions(+)
 create mode 100644 components/viz/service/display_embedder/w10m_software_output_device.h

diff --git a/components/viz/service/BUILD.gn b/components/viz/service/BUILD.gn
index 2488069770015aa9242bf297cb12b71bf6f76aea..f3d928a48b6b3dc73153dd1eb797b68fe757f932 100644
--- a/components/viz/service/BUILD.gn
+++ b/components/viz/service/BUILD.gn
@@ -157,6 +157,7 @@ viz_component("service") {
     "display_embedder/output_surface_provider.h",
     "display_embedder/output_surface_provider_impl.cc",
     "display_embedder/output_surface_provider_impl.h",
+    "display_embedder/w10m_software_output_device.h",
     "display_embedder/skia_output_device.cc",
     "display_embedder/skia_output_device.h",
     "display_embedder/skia_output_device_buffer_queue.cc",
diff --git a/components/viz/service/display_embedder/output_surface_provider_impl.cc b/components/viz/service/display_embedder/output_surface_provider_impl.cc
index 0a1c0ebd232fc7a3906cf4a98d568a36ec14a67e..8c3c3e496173d8ff9388058b22aa2a5b9e03df41 100644
--- a/components/viz/service/display_embedder/output_surface_provider_impl.cc
+++ b/components/viz/service/display_embedder/output_surface_provider_impl.cc
@@ -33,6 +33,12 @@
 #include "gpu/ipc/common/surface_handle.h"
 #include "ui/base/ui_base_switches.h"
 
+#if defined(VENETIUM_W10M)
+#include <atomic>
+
+#include "components/viz/service/display_embedder/w10m_software_output_device.h"
+#endif
+
 #if BUILDFLAG(IS_WIN)
 #include "components/viz/service/display_embedder/software_output_device_win.h"
 #endif
@@ -60,6 +66,21 @@
 
 namespace viz {
 
+#if defined(VENETIUM_W10M)
+namespace {
+std::atomic<W10mSoftwareOutputDeviceFactory> g_w10m_device_factory{nullptr};
+}  // namespace
+
+void SetW10mSoftwareOutputDeviceFactory(
+    W10mSoftwareOutputDeviceFactory factory) {
+  g_w10m_device_factory.store(factory);
+}
+
+W10mSoftwareOutputDeviceFactory GetW10mSoftwareOutputDeviceFactory() {
+  return g_w10m_device_factory.load();
+}
+#endif  // defined(VENETIUM_W10M)
+
 OutputSurfaceProviderImpl::OutputSurfaceProviderImpl(
     GpuServiceImpl* gpu_service_impl,
     bool headless)
@@ -142,6 +163,16 @@ std::unique_ptr<SoftwareOutputDevice>
 OutputSurfaceProviderImpl::CreateSoftwareOutputDeviceForPlatform(
     gpu::SurfaceHandle surface_handle,
     mojom::DisplayClient* display_client) {
+#if defined(VENETIUM_W10M)
+  // No HWND on Windows 10 Mobile: frames go to the app's view.
+  if (W10mSoftwareOutputDeviceFactory factory =
+          GetW10mSoftwareOutputDeviceFactory()) {
+    if (std::unique_ptr<SoftwareOutputDevice> device =
+            factory(surface_handle)) {
+      return device;
+    }
+  }
+#endif
   if (headless_)
     return std::make_unique<SoftwareOutputDevice>();
 
diff --git a/components/viz/service/display_embedder/w10m_software_output_device.h b/components/viz/service/display_embedder/w10m_software_output_device.h
new file mode 100644
index 0000000000000000000000000000000000000000..c5e7a7a34f59ecdae81d6b459c8b0ce63b182a12
--- /dev/null
+++ b/components/viz/service/display_embedder/w10m_software_output_device.h
@@ -0,0 +1,32 @@
+// Copyright 2026 The Venetium-W10M Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef COMPONENTS_VIZ_SERVICE_DISPLAY_EMBEDDER_W10M_SOFTWARE_OUTPUT_DEVICE_H_
+#define COMPONENTS_VIZ_SERVICE_DISPLAY_EMBEDDER_W10M_SOFTWARE_OUTPUT_DEVICE_H_
+
+#include <memory>
+
+#include "components/viz/service/viz_service_export.h"
+#include "gpu/ipc/common/surface_handle.h"
+
+namespace viz {
+
+class SoftwareOutputDevice;
+
+// Windows 10 Mobile has no HWND to draw a software frame into: the engine
+// runs in a UWP app, and its browser window is an aura host with no native
+// window at all. The embedder installs a factory here that makes an output
+// device whose frames go to the app's XAML view instead; software display
+// compositing then uses it for every root surface.
+using W10mSoftwareOutputDeviceFactory =
+    std::unique_ptr<SoftwareOutputDevice> (*)(gpu::SurfaceHandle handle);
+
+VIZ_SERVICE_EXPORT void SetW10mSoftwareOutputDeviceFactory(
+    W10mSoftwareOutputDeviceFactory factory);
+VIZ_SERVICE_EXPORT W10mSoftwareOutputDeviceFactory
+GetW10mSoftwareOutputDeviceFactory();
+
+}  // namespace viz
+
+#endif  // COMPONENTS_VIZ_SERVICE_DISPLAY_EMBEDDER_W10M_SOFTWARE_OUTPUT_DEVICE_H_
