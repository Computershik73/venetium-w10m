+#include "components/content_settings/core/browser/host_content_settings_map.h"
+#include "content/public/common/url_constants.h"
+#endif
 #include "components/profile_metrics/browser_profile_type.h"
 #include "components/saved_tab_groups/public/features.h"
 #include "components/signin/public/base/signin_metrics.h"
@@ -1292,6 +1301,26 @@ constexpr int kW10mShellSubmenu = kW10mShellCommandFirst + 9;
 constexpr int kW10mJitCommand = kW10mShellCommandFirst + 4;
 AppMenuModel::W10mShellCommandHandler g_w10m_shell_command = nullptr;
 bool g_w10m_jit_on = false;
+AppMenuModel::W10mPinAppHandler g_w10m_pin_app = nullptr;
+
+// The page's address when the built-in ad blocker may work on it.
+GURL W10mAdBlockSite(Browser* browser) {
+  content::WebContents* contents =
+      browser->tab_strip_model()->GetActiveWebContents();
+  if (!contents) {
+    return GURL();
+  }
+  const GURL url = contents->GetLastCommittedURL();
+  return url.SchemeIsHTTPOrHTTPS() ? url : GURL();
+}
+
+// Whether the ad blocker works on |url| (an "Ads" exception that allows
+// them turns it off for the site).
+bool W10mBlocksAds(Profile* profile, const GURL& url) {
+  return HostContentSettingsMapFactory::GetForProfile(profile)
+             ->GetContentSetting(url, url, ContentSettingsType::ADS) !=
+         CONTENT_SETTING_ALLOW;
+}
 
 bool IsW10mShellCommand(int command_id) {
   return (command_id >= kW10mShellCommandFirst &&
@@ -1311,6 +1340,16 @@ void AppMenuModel::SetW10mShellCommandHandler(
 void AppMenuModel::SetW10mJitOn(bool on) {
   g_w10m_jit_on = on;
 }
+
+// static
+void AppMenuModel::SetW10mPinAppHandler(W10mPinAppHandler handler) {
+  g_w10m_pin_app = handler;
+}
+
+// static
+AppMenuModel::W10mPinAppHandler AppMenuModel::GetW10mPinAppHandler() {
+  return g_w10m_pin_app;
+}
 #endif  // defined(VENETIUM_W10M)
 
 #if defined(VENETIUM_W10M)
@@ -1357,6 +1396,32 @@ void AppMenuModel::BuildPhoneMenu() {
                                       sub_menus_.back().get(), kDevicesIcon);
   AddSeparator(ui::NORMAL_SEPARATOR);
 
+  // The page: find in it, zoom, print; install it as an app, or open the
+  // installed apps; the ad blocker on it.
+  AddItemWithStringIdAndVectorIcon(
+      this, IDC_FIND, IDS_FIND,
+      features::IsRoundedIconsEnabled() ? kFindInPageIcon : kSearchMenuOldIcon);
+  CreateZoomMenu();
+  AddItemWithStringIdAndVectorIcon(
+      this, IDC_PRINT, IDS_PRINT,
+      features::IsRoundedIconsEnabled() ? kPrintIcon : kPrintMenuOldIcon);
+  if (std::u16string install_item = GetInstallPWALabel(browser_);
+      !install_item.empty()) {
+    AddItemWithIcon(IDC_INSTALL_PWA, install_item,
+                    GetInstallPWAIcon(browser_));
+  } else if (std::u16string open_item = GetOpenPWALabel(browser_);
+             !open_item.empty()) {
+    AddItemWithIcon(IDC_OPEN_IN_PWA_WINDOW, open_item,
+                    ui::ImageModel::FromVectorIcon(
+                        features::IsRoundedIconsEnabled()
+                            ? kDesktopWindowsIcon
+                            : kDesktopWindowsChromeRefreshOldIcon,
+                        ui::kColorMenuIcon, kDefaultIconSize));
+  }
+  AddItem(kW10mAppsCommand, u"Apps");
+  AddCheckItem(kW10mBlockAdsCommand, u"Block ads on this site");
+  AddSeparator(ui::NORMAL_SEPARATOR);
+
   AddItemWithStringIdAndVectorIcon(this, IDC_OPTIONS, IDS_SETTINGS,
                                    kSettingsIcon);
   AddItemWithStringIdAndVectorIcon(this, IDC_HELP_PAGE_VIA_MENU,
@@ -1377,6 +1442,41 @@ void AppMenuModel::BuildPhoneMenu() {
 
 void AppMenuModel::ExecuteCommand(int command_id, int event_flags) {
 #if defined(VENETIUM_W10M)
+  if (command_id == kW10mBlockAdsCommand) {
+    // Decided as a page loads: the page is loaded again.
+    const GURL site = W10mAdBlockSite(browser_);
+    if (site.is_valid()) {
+      HostContentSettingsMapFactory::GetForProfile(browser_->profile())
+          ->SetContentSettingDefaultScope(
+              site, GURL(), ContentSettingsType::ADS,
+              W10mBlocksAds(browser_->profile(), site)
+                  ? CONTENT_SETTING_ALLOW
+                  : CONTENT_SETTING_DEFAULT);
+      chrome::Reload(browser_, WindowOpenDisposition::CURRENT_TAB);
+    }
+    return;
+  }
+  if (command_id == kW10mAppsCommand) {
+    ShowSingletonTab(browser_->GetBrowserForOpeningWebUi(),
+                     GURL(std::string(content::kChromeUIScheme) + "://" +
+                          chrome::kChromeUIAppLauncherPageHost));
+    return;
+  }
+  if (command_id == kW10mPinToStartCommand) {
+    if (g_w10m_pin_app && browser_->app_controller()) {
+      g_w10m_pin_app(browser_);
+    }
+    return;
+  }
+  if (command_id == kW10mAppColorsCommand) {
+    PrefService* prefs = browser_->profile()->GetPrefs();
+    prefs->SetBoolean(w10m::prefs::kAppThemeColors,
+                      !prefs->GetBoolean(w10m::prefs::kAppThemeColors));
+    if (browser_->app_controller()) {
+      browser_->app_controller()->DidChangeThemeColor();
+    }
+    return;
+  }
   if (command_id == kW10mJitCommand) {
     g_w10m_jit_on = !g_w10m_jit_on;
     if (g_w10m_shell_command) {
@@ -2091,6 +2191,14 @@ bool AppMenuModel::IsCommandIdChecked(int command_id) const {
   if (command_id == kW10mJitCommand) {
     return g_w10m_jit_on;
   }
+  if (command_id == kW10mBlockAdsCommand) {
+    const GURL site = W10mAdBlockSite(browser_);
+    return site.is_valid() && W10mBlocksAds(browser_->profile(), site);
+  }
+  if (command_id == kW10mAppColorsCommand) {
+    return browser_->profile()->GetPrefs()->GetBoolean(
+        w10m::prefs::kAppThemeColors);
+  }
 #endif
   PrefService* prefs = browser_->profile()->GetPrefs();
   if (command_id == IDC_SHOW_BOOKMARK_BAR) {
@@ -2121,9 +2229,16 @@ bool AppMenuModel::IsCommandIdChecked(int command_id) const {
 
 bool AppMenuModel::IsCommandIdEnabled(int command_id) const {
 #if defined(VENETIUM_W10M)
-  if (IsW10mShellCommand(command_id)) {
+  if (IsW10mShellCommand(command_id) || command_id == kW10mAppsCommand ||
+      command_id == kW10mAppColorsCommand) {
     return true;
   }
+  if (command_id == kW10mBlockAdsCommand) {
+    return W10mAdBlockSite(browser_).is_valid();
+  }
+  if (command_id == kW10mPinToStartCommand) {
+    return g_w10m_pin_app && browser_->app_controller();
+  }
 #endif
   GlobalError* error =
       GlobalErrorServiceFactory::GetForProfile(browser_->profile())
diff --git a/chrome/browser/ui/toolbar/app_menu_model.h b/chrome/browser/ui/toolbar/app_menu_model.h
