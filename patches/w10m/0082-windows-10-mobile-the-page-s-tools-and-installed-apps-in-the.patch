   // The first row of the phone's menu, as Chrome for Android's: back,
   // forward, bookmark, download and reload as icons (AppMenu draws it).
   static constexpr int kW10mNavigationRow = 40989;
+
+  // Windows 10 Mobile's own items, beside Chrome's commands. In the
+  // phone's menu: the built-in ad blocker on this site (checked: it
+  // blocks), the installed apps (chrome://apps). In an app's menu: pin the
+  // app to Start, and its window in the app's colours or the browser's.
+  static constexpr int kW10mBlockAdsCommand = 40980;
+  static constexpr int kW10mAppsCommand = 40981;
+  static constexpr int kW10mPinToStartCommand = 40982;
+  static constexpr int kW10mAppColorsCommand = 40983;
+  // Pins the app of |browser|'s window to Start: the embedder's tile.
+  using W10mPinAppHandler = void (*)(Browser* browser);
+  static void SetW10mPinAppHandler(W10mPinAppHandler handler);
+  static W10mPinAppHandler GetW10mPinAppHandler();
 #endif
 
   DECLARE_CLASS_ELEMENT_IDENTIFIER_VALUE(kCreateNewTabGroupTopLevel);
