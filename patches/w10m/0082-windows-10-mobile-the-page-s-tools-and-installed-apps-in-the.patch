+#if defined(VENETIUM_W10M)
+namespace {
+
+// Windows 10 Mobile: a dialog's or a bubble's width, no wider than the
+// screen (a phone's is 360 DIP) less a margin each side.
+int FitScreen(int width) {
+  display::Screen* screen = display::Screen::Get();
+  if (!screen) {
+    return width;
+  }
+  const int room = screen->GetPrimaryDisplay().work_area().width() - 16;
+  return room > 200 ? std::min(width, room) : width;
+}
+
+}  // namespace
+#endif
