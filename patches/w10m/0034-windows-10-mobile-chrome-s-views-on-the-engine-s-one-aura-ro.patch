+#endif
+
 #if BUILDFLAG(IS_LINUX)
   bool WindowManagerProvidesTitleBar(bool maximized) override;
   gfx::ImageSkia* GetDefaultWindowIcon() const override;
diff --git a/chrome/browser/ui/views/chrome_views_delegate_win.cc b/chrome/browser/ui/views/chrome_views_delegate_win.cc
index a376c75811adb7c9c2f9f7dc663193b819b86f0f..85ecdd62d1249a36ab0d88870d4fff3a85a910fd 100644
--- a/chrome/browser/ui/views/chrome_views_delegate_win.cc
+++ b/chrome/browser/ui/views/chrome_views_delegate_win.cc
@@ -121,9 +121,24 @@ HICON ChromeViewsDelegate::GetSmallWindowIcon() const {
   return GetSmallAppIcon();
 }
 
+#if defined(VENETIUM_W10M)
+// The browser window fills the phone's screen, always maximized, and the
+// phone has no title bar to drag or buttons to press: none is drawn for it.
+// Dialogs, which are not maximized, keep their title and close button.
+bool ChromeViewsDelegate::WindowManagerProvidesTitleBar(bool maximized) {
+  return maximized;
+}
+#endif
+
 views::NativeWidget* ChromeViewsDelegate::CreateNativeWidget(
     views::Widget::InitParams* params,
     views::internal::NativeWidgetDelegate* delegate) {
+#if defined(VENETIUM_W10M)
+  // No top-level windows of the system's on Windows 10 Mobile: every widget
+  // is a window under the engine's one aura root (native_widget_factory.cc).
+  return ::CreateNativeWidget(NativeWidgetType::kNativeWidgetAura, params,
+                              delegate);
+#else
   // Check the force_software_compositing flag only on Windows. If this flag is
   // on, it means that the widget being created wants to use the software
   // compositor which requires a top level window. We cannot have a mixture of
@@ -158,6 +173,7 @@ views::NativeWidget* ChromeViewsDelegate::CreateNativeWidget(
   }
 
   return ::CreateNativeWidget(native_widget_type, params, delegate);
+#endif  // defined(VENETIUM_W10M)
 }
 
 int ChromeViewsDelegate::GetAppbarAutohideEdges(HMONITOR monitor,
