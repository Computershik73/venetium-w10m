diff --git a/chrome/browser/ui/views/native_widget_factory.cc b/chrome/browser/ui/views/native_widget_factory.cc
index 24b84fafdcc80da4f31cb267ec3ad377fe361954..807fd446b5c75fc538cadbd835ff98f7e322b1f2 100644
--- a/chrome/browser/ui/views/native_widget_factory.cc
+++ b/chrome/browser/ui/views/native_widget_factory.cc
@@ -10,10 +10,30 @@
 #include "ui/views/widget/desktop_aura/desktop_native_widget_aura.h"
 #include "ui/views/widget/native_widget_aura.h"
 
+#if defined(VENETIUM_W10M)
+#include "ui/aura/env.h"
+#include "ui/aura/window_tree_host.h"
+#endif
+
 views::NativeWidget* CreateNativeWidget(
     NativeWidgetType type,
     views::Widget::InitParams* params,
     views::internal::NativeWidgetDelegate* delegate) {
+#if defined(VENETIUM_W10M)
+  // Windows 10 Mobile gives an app one window, the shell's panel, and the
+  // engine one aura root in it, with no HWND behind it. Every widget is a
+  // window under that root, as on ChromeOS: a desktop widget would make a
+  // window tree host of its own, with nothing to show it.
+  type = NativeWidgetType::kNativeWidgetAura;
+  if (params->context) {
+    params->context = params->context->GetRootWindow();
+  }
+  if (!params->parent && !params->context) {
+    const auto& hosts = aura::Env::GetInstance()->window_tree_hosts();
+    CHECK(!hosts.empty()) << "a widget before the engine's root window";
+    params->context = hosts.front()->window();
+  }
+#endif
   // While the majority of the time, context wasn't plumbed through due to the
   // existence of a global WindowParentingClient, if this window is toplevel,
   // it's possible that there is no contextual state that we can use.
diff --git a/chrome/browser/ui/views/status_icons/status_tray_win.cc b/chrome/browser/ui/views/status_icons/status_tray_win.cc
index 2b6da989844d79dee86195848318ec96eb32c6b4..747c77d6f34f2f04e7722a3f27beabfc643a044f 100644
--- a/chrome/browser/ui/views/status_icons/status_tray_win.cc
+++ b/chrome/browser/ui/views/status_icons/status_tray_win.cc
@@ -243,5 +243,12 @@ void StatusTrayWin::SetStatusTrayStateChangerProxyForTest(
 }
 
 std::unique_ptr<StatusTray> StatusTray::Create() {
+#if defined(VENETIUM_W10M)
+  // Windows 10 Mobile has no notification area, and StatusTrayWin CHECKs
+  // the window class it cannot register there. Chrome goes without a tray,
+  // as on Android.
+  return nullptr;
+#else
   return std::make_unique<StatusTrayWin>();
+#endif
 }
diff --git a/chrome/browser/ui/views/tabs/dragging/tab_drag_controller.cc b/chrome/browser/ui/views/tabs/dragging/tab_drag_controller.cc
index e4862f8b3c69e3104cb0b307c70260241d50ac1b..4b61306fe08a4a583ee292f0cbd7b4cc1c3ca4aa 100644
--- a/chrome/browser/ui/views/tabs/dragging/tab_drag_controller.cc
+++ b/chrome/browser/ui/views/tabs/dragging/tab_drag_controller.cc
@@ -466,6 +466,12 @@ TabDragController::Liveness TabDragController::Init(
       ref->detach_behavior_ = DetachBehavior::kNotDetachable;
     }
   }
+#if defined(VENETIUM_W10M)
+  // On a phone's one screen a tab dragged out of the strip would become a
+  // window that covers the first, with nothing to drag it by: tabs only
+  // change places.
+  ref->detach_behavior_ = DetachBehavior::kNotDetachable;
+#endif
 #endif  // BUILDFLAG(IS_MAC)
 
   ref->source_context_emptiness_tracker_ =
diff --git a/ui/views/widget/desktop_aura/desktop_native_widget_aura.cc b/ui/views/widget/desktop_aura/desktop_native_widget_aura.cc
index 41725080f2ac007e30266ff83e859578b9e8887d..8ea6728abd462c545de54a48728c04f0e3696f19 100644
--- a/ui/views/widget/desktop_aura/desktop_native_widget_aura.cc
+++ b/ui/views/widget/desktop_aura/desktop_native_widget_aura.cc
@@ -569,6 +569,14 @@ Widget::Widgets DesktopNativeWidgetAura::GetOwnedDesktopWidgets() {
 ////////////////////////////////////////////////////////////////////////////////
 // DesktopNativeWidgetAura, internal::NativeWidgetPrivate implementation:
 void DesktopNativeWidgetAura::InitNativeWidget(Widget::InitParams params) {
+#if defined(VENETIUM_W10M)
+  // On Windows 10 Mobile every widget is a NativeWidgetAura under the
+  // engine's one root (chrome/browser/ui/views/native_widget_factory.cc). A
+  // desktop widget would bring a second compositor with nothing to show it,
+  // whose frames the engine would take for the root's: better to know at
+  // once which one slipped through.
+  LOG(FATAL) << "a desktop widget on Windows 10 Mobile: " << params.name;
+#endif
   ownership_ = params.ownership;
   widget_type_ = params.type;
   name_ = params.name;
