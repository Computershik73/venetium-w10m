diff --git a/media/filters/decoder_stream.cc b/media/filters/decoder_stream.cc
index 738c726d8152be34373c9de6e0094dd0fdd43299..98fb51f30ed38e0c7f251ef4a271469ef03a452c 100644
--- a/media/filters/decoder_stream.cc
+++ b/media/filters/decoder_stream.cc
@@ -195,6 +195,14 @@ void DecoderStream<StreamType>::Read(ReadCB read_cb) {
     read_cb_ = base::BindPostTaskToCurrentDefault(std::move(read_cb));
     // OnDecodeDone, OnBufferReady, and CompleteDecoderReinitialization all set
     // kStateError and call SatisfyRead, passing the error back to a ReadCB.
+#if defined(VENETIUM_W10M)
+    // Unless nobody was reading then (w10m_platform_decode_failure_).
+    if (w10m_platform_decode_failure_) {
+      w10m_platform_decode_failure_ = false;
+      SatisfyRead(DecoderStatus::Codes::kPlatformDecodeFailure);
+      return;
+    }
+#endif
     SatisfyRead(DecoderStatus::Codes::kDecoderStreamInErrorState);
     return;
   }
@@ -676,6 +684,12 @@ void DecoderStream<StreamType>::OnDecodeDone(
 
         state_ = State::kStateError;
         ClearOutputs();
+#if defined(VENETIUM_W10M)
+        // Kept for the next Read() when there is none to tell now.
+        w10m_platform_decode_failure_ =
+            StreamType == DemuxerStream::VIDEO && !read_cb_ &&
+            status.code() == DecoderStatus::Codes::kPlatformDecodeFailure;
+#endif
         if (read_cb_)
           SatisfyRead(std::move(status));
       }
diff --git a/media/filters/decoder_stream.h b/media/filters/decoder_stream.h
index bb6c5667eddc45b846fcfd93df2e99fac974c188..5ebf85d8a8def1e77319da3c1f9b7464bb307bcb 100644
--- a/media/filters/decoder_stream.h
+++ b/media/filters/decoder_stream.h
@@ -307,6 +307,17 @@ class MEDIA_EXPORT DecoderStream {
 
   int fallback_buffers_being_decoded_ = 0;
 
+#if defined(VENETIUM_W10M)
+  // Windows 10 Mobile: a hardware decoder's failure
+  // (DecoderStatus::Codes::kPlatformDecodeFailure) put the stream into
+  // kStateError while nobody was reading -- the usual case in steady
+  // playback, where frames are decoded ahead of the reads. The next Read()
+  // is told that code and not kDecoderStreamInErrorState, so that
+  // VideoRendererImpl can tell it from a bad stream and have the player
+  // start again with the software decoder.
+  bool w10m_platform_decode_failure_ = false;
+#endif
+
   // Last timestamp seen by DecodeInternal(), used for average duration when
   // explicit duration information is missing.
   base::TimeDelta last_buffer_timestamp_ = kNoTimestamp;
