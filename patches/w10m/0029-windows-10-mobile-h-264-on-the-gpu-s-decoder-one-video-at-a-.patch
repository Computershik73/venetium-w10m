index b09ce3452538b2650b5d205c25a8b209995b9214..918d5b9f59dbd7227bed3e2e79085f10f9f9d6d6 100644
--- a/media/gpu/windows/d3d11_video_decoder.cc
+++ b/media/gpu/windows/d3d11_video_decoder.cc
@@ -46,6 +46,22 @@
 #include "ui/gl/gl_angle_util_win.h"
 #include "ui/gl/gl_switches.h"
 
+#if defined(VENETIUM_W10M)
+#include <algorithm>
+#include <string>
+
+#include "base/command_line.h"
+#include "base/json/json_writer.h"
+#include "base/logging.h"
