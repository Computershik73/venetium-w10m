+
 namespace media {
 
 namespace {
@@ -101,6 +117,183 @@ bool ShouldUseDXVADeviceForHEVCRangeExtension(const VideoDecoderConfig& config,
 BASE_FEATURE(kSetDefaultColorSpaceForVideoFrameAndSharedImage,
              base::FEATURE_ENABLED_BY_DEFAULT);
 
+#if defined(VENETIUM_W10M)
+// Windows 10 Mobile. All of this runs on the GPU main thread -- the media
+// service has a thread of its own only with Graphite on Dawn
+// (content/gpu/gpu_service_factory.cc) -- in a process that is the whole
+// browser, on Adreno drivers that gecko-w10m has met:
+//  - with a second DXVA decoder beside the first, and with one made the
+//    moment another video's was dropped, the Adreno 530's driver recursed
+//    until its stack ran out. So one video at a time has the GPU's decoder
+//    (the others are refused in Initialize(), and the page's player goes on
+//    to the software decoder), one decoder of the driver's exists at a time,
+//    and another video's waits until the last has been gone a while
+//    (--vw-video-settle-ms, 1000; 0 is no wait);
+//  - a driver that ends the process when it is asked to decode would end
+//    every run that plays a video: the embedder is told when the driver is
+//    asked and when frames have come out for a while (ui/gl/w10m_panel.h),
+//    and counts the runs that ended in between.
+
+// The decoder that has the GPU's, or null.
+const void* g_w10m_owner = nullptr;
+// When the driver's decoder was last let go of.
+base::TimeTicks g_w10m_released;
+// When a decoder last failed after it had started decoding. For a while from
+// then no video is given the GPU's decoder: the player that starts again
+// after the failure (media/renderers/video_renderer_impl.cc) gets the
+// software one.
+base::TimeTicks g_w10m_failed;
+constexpr base::TimeDelta kW10mFailedHold = base::Seconds(10);
+// The embedder has been told kStarting, and nothing since.
+bool g_w10m_watched = false;
+// Frames out of the driver's present decoder, and when the first came.
+int g_w10m_frames = 0;
+base::TimeTicks g_w10m_first_frame;
+// Decoders that failed one after another with no frame out of any. After
+// three this run asks the driver for no more: on a phone whose driver cannot
+// do it, every video would otherwise start with a failure.
+int g_w10m_fruitless = 0;
+
+// --name=N among the switches (the shell's Engine switches), or |fallback|.
+int W10mSwitchInt(const char* name, int fallback) {
+  const std::string text =
+      base::CommandLine::ForCurrentProcess()->GetSwitchValueASCII(name);
+  int value = 0;
+  return !text.empty() && base::StringToInt(text, &value) && value >= 0
+             ? value
+             : fallback;
+}
+
+// The embedder hears kStarting and then one of the others, in turn.
+void W10mTell(gl::W10mVideoEvent event) {
+  const bool starting = event == gl::W10mVideoEvent::kStarting;
+  if (g_w10m_watched == starting) {
+    return;
+  }
+  g_w10m_watched = starting;
+  gl::W10mVideo(event);
+}
+
+// Ticks once a second while a video has the GPU's decoder
+// (ResetD3DVideoDecoder()).
+base::RepeatingTimer& W10mGlWatch() {
+  static base::NoDestructor<base::RepeatingTimer> timer;
+  return *timer;
+}
+
+// |decoder| has the GPU's decoder no longer.
+void W10mSessionGone(const void* decoder, ID3D11Device* device) {
+  if (g_w10m_owner != decoder) {
+    return;
+  }
+  g_w10m_owner = nullptr;
+  W10mGlWatch().Stop();
+  W10mTell(device && FAILED(device->GetDeviceRemovedReason())
+               ? gl::W10mVideoEvent::kLost
+               : gl::W10mVideoEvent::kEnded);
+}
+
+// Waits, |ms| at most, until the GPU has done what it was given: the decode,
+// before anything reads the picture. Off unless --vw-video-sync-ms says how
+// long. It holds the one GPU thread (gecko-w10m measured 10 to 16 ms a frame
+// at 1080p on the Adreno 530, where it turned out not to be needed) and is
+// for a driver that shows a surface's earlier picture, as the Adreno 304's
+// did at feature level 9_3. A sleep is a whole 15 ms tick on these phones,
+// hence the yields first.
+void W10mWaitForGpu(ID3D11Device* device,
+                    ID3D11DeviceContext* context,
+                    int ms) {
+  D3D11_QUERY_DESC desc = {D3D11_QUERY_EVENT, 0};
+  Microsoft::WRL::ComPtr<ID3D11Query> query;
+  if (FAILED(device->CreateQuery(&desc, &query))) {
+    return;
+  }
+  context->End(query.Get());
+  context->Flush();
+  const base::TimeTicks start = base::TimeTicks::Now();
+  BOOL done = FALSE;
+  while (context->GetData(query.Get(), &done, sizeof(done),
+                          D3D11_ASYNC_GETDATA_DONOTFLUSH) != S_OK ||
+         !done) {
+    const base::TimeDelta waited = base::TimeTicks::Now() - start;
+    if (waited >= base::Milliseconds(ms)) {
+      break;
+    }
+    if (waited < base::Milliseconds(4)) {
+      base::PlatformThread::YieldCurrentThread();
+    } else {
+      base::PlatformThread::Sleep(base::Milliseconds(1));
+    }
+  }
+}
+
+// What the driver says of H.264 on ANGLE's device, for the log, and whether
+// this decoder can drive it: slices are sent in DXVA's short format only
+// (ConfigBitstreamRaw 2, d3d11_video_decoder_wrapper.cc), which a driver
+// need not take. gecko-w10m's own probe asks the same things.
+bool W10mH264Usable(ComD3D11Device device) {
+  ComD3D11VideoDevice video_device;
+  ComD3D11DeviceContext context;
+  ComD3D11VideoContext video_context;
+  device->GetImmediateContext(&context);
+  const HRESULT device_hr = device.As(&video_device);
+  const HRESULT context_hr = context.As(&video_context);
+  if (FAILED(device_hr) || FAILED(context_hr)) {
+    LOG(WARNING) << "video: decoded in software: ANGLE's device has no "
+                    "Direct3D 11 video interfaces (device 0x"
+                 << std::hex << device_hr << ", context 0x" << context_hr
+                 << ")";
+    return false;
+  }
+  bool listed = false;
+  const UINT profiles = video_device->GetVideoDecoderProfileCount();
+  for (UINT i = 0; i < profiles; ++i) {
+    GUID profile = {};
+    if (SUCCEEDED(video_device->GetVideoDecoderProfile(i, &profile)) &&
+        profile == D3D11_DECODER_PROFILE_H264_VLD_NOFGT) {
+      listed = true;
+    }
+  }
+  BOOL nv12 = FALSE;
+  UINT configs = 0;
+  unsigned slice_formats = 0;
+  unsigned single_textures = 0;
+  if (listed) {
+    video_device->CheckVideoDecoderFormat(
+        &D3D11_DECODER_PROFILE_H264_VLD_NOFGT, DXGI_FORMAT_NV12, &nv12);
+    const D3D11_VIDEO_DECODER_DESC desc = {
+        D3D11_DECODER_PROFILE_H264_VLD_NOFGT, 1920, 1088, DXGI_FORMAT_NV12};
+    if (FAILED(video_device->GetVideoDecoderConfigCount(&desc, &configs))) {
+      configs = 0;
+    }
+    for (UINT i = 0; i < configs; ++i) {
+      D3D11_VIDEO_DECODER_CONFIG decoder_config = {};
+      if (SUCCEEDED(
+              video_device->GetVideoDecoderConfig(&desc, i, &decoder_config))) {
+        slice_formats |= 1u << (decoder_config.ConfigBitstreamRaw & 7);
+        if (decoder_config.ConfigDecoderSpecific & (1 << 14)) {
+          ++single_textures;
+        }
+      }
+    }
+  }
+  const bool usable = listed && nv12 && (slice_formats & (1u << 2));
+  LOG(WARNING) << "video: "
+               << (usable ? "H.264 can go to the GPU's decoder"
+                          : "decoded in software")
+               << ": ANGLE's device (feature level 0x" << std::hex
+               << static_cast<unsigned>(device->GetFeatureLevel()) << std::dec
+               << ") lists " << profiles << " decoder profiles, H.264 "
+               << (listed ? "among them" : "not among them") << ", NV12 "
+               << (nv12 ? "yes" : "no") << ", " << configs
+               << " configurations at 1920x1088 (slice formats 0x" << std::hex
+               << slice_formats << std::dec
+               << ", of which 0x4 is the short one this decoder sends; "
+               << single_textures << " want single textures, not an array)";
+  return usable;
+}
+#endif  // defined(VENETIUM_W10M)
+
 }  // namespace
 
 std::unique_ptr<VideoDecoder> D3D11VideoDecoder::Create(
@@ -166,6 +359,21 @@ D3D11VideoDecoder::~D3D11VideoDecoder() {
 
   // Explicitly destroy the decoder, since it can reference picture buffers.
   accelerated_video_decoder_.reset();
+
+#if defined(VENETIUM_W10M)
+  // The driver's decoder and its pictures go now, with a flush to carry the
+  // releases out (Direct3D 11 puts them off, and the flush above came before
+  // there was anything to carry): the next video's decoder must not find
+  // this one there.
+  const bool had_decoder = !!d3d_video_decoder_wrapper_;
+  picture_buffers_.clear();
+  d3d_video_decoder_wrapper_.reset();
+  if (had_decoder) {
+    device_context_->Flush();
+    g_w10m_released = base::TimeTicks::Now();
+  }
+  W10mSessionGone(this, device_.Get());
+#endif
 }
 
 VideoDecoderType D3D11VideoDecoder::GetDecoderType() const {
@@ -210,6 +418,46 @@ bool D3D11VideoDecoder::InitializeAcceleratedDecoder(
 }
 
 bool D3D11VideoDecoder::ResetD3DVideoDecoder() {
+#if defined(VENETIUM_W10M)
+  // One video at a time has the GPU's decoder. Initialize() has refused the
+  // others; this is the net under it.
+  if (g_w10m_owner && g_w10m_owner != this) {
+    NotifyError({D3D11StatusCode::kDecoderCreationFailed,
+                 "another video has the GPU's decoder"},
+                DecoderStatus::Codes::kTooManyDecoders);
+    return false;
+  }
+  if (!g_w10m_owner) {
+    g_w10m_owner = this;
+    // The last video's frames are not this one's: NotifyError() tells a
+    // failure before the first frame from one after it by this count.
+    g_w10m_frames = 0;
+    // GL given up -- its context lost, a surface that could not be made --
+    // leaves this decoder with nobody to draw its frames, and those it has
+    // given out may never come back for it to notice anything by (their
+    // release waits for a sync token of the lost context). Whoever waits for
+    // a frame is told that the decoder failed, and the page's player starts
+    // again with the software one (media/renderers/video_renderer_impl.cc).
+    // A decoder nobody waits for says so at its next Decode() (DoDecode()).
+    W10mGlWatch().Start(
+        FROM_HERE, base::Seconds(1),
+        base::BindRepeating(
+            [](base::WeakPtr<D3D11VideoDecoder> self) {
+              if (self && gl::W10mGpuIsGivenUp() &&
+                  self->state_ == State::kRunning &&
+                  (self->current_decode_cb_ ||
+                   !self->input_buffer_queue_.empty())) {
+                self->NotifyError(
+                    {D3D11StatusCode::kDecoderFailedDecode,
+                     "GL has been given up"},
+                    DecoderStatus::Codes::kPlatformDecodeFailure);
+              }
+            },
+            weak_factory_.GetWeakPtr()));
+  }
+  // Before the driver is asked anything for this video.
+  W10mTell(gl::W10mVideoEvent::kStarting);
+#endif
   // By default we assume outputs are 8-bit for SDR color spaces and 10 bit for
   // HDR color spaces (or VP9.2, or HEVC Main10, or HEVC Rext) with HBD capable
   // codecs (the decoder doesn't support H264PROFILE_HIGH10PROFILE). We'll get
@@ -261,6 +509,45 @@ bool D3D11VideoDecoder::ResetD3DVideoDecoder() {
     return false;
   }
 
+#if defined(VENETIUM_W10M)
+  // Upstream makes the driver's decoder here from Initialize() and, at the
+  // first picture, usually another beside it before it drops the first: the
+  // picture's coded size and colour are seldom the container's. Here the
+  // one there is goes first, its pictures with it (those a page still shows
+  // live on until it lets go of them), and a flush carries the release out;
+  // and none is made from Initialize(): DoDecode() comes back here when the
+  // first picture's parameters are known (kConfigChange), and that decoder
+  // is the stream's one. When the parameters change later (another quality)
+  // the new one follows the old at once; --vw-video-remake-ms=N puts up to
+  // 500 ms between them, on this thread, should a driver need the time.
+  if (d3d_video_decoder_wrapper_) {
+    picture_buffers_.clear();
+    d3d_video_decoder_wrapper_.reset();
+    device_context_->Flush();
+    g_w10m_released = base::TimeTicks::Now();
+  }
+  if (state_ == State::kInitializing) {
+    bit_depth_ = bit_depth;
+    decoder_configurator_ = std::move(decoder_configurator);
+    texture_selector_ = std::move(texture_selector);
+    return true;
+  }
+  std::string w10m_after = "the first of this run";
+  if (!g_w10m_released.is_null()) {
+    const base::TimeDelta wait =
+        base::Milliseconds(
+            std::min(W10mSwitchInt("vw-video-remake-ms", 0), 500)) -
+        (base::TimeTicks::Now() - g_w10m_released);
+    if (wait.is_positive()) {
+      base::PlatformThread::Sleep(wait);
+    }
+    w10m_after =
+        base::NumberToString(
+            (base::TimeTicks::Now() - g_w10m_released).InMilliseconds()) +
+        " ms after the last one went";
+  }
+#endif
+
   auto video_decoder_wrapper =
       CreateD3DVideoDecoderWrapper(decoder_configurator.get(), bit_depth);
   if (!video_decoder_wrapper) {
