+// Venetium 0057: with "Preload pages" off (Venetium's default, 0005) the
+// PreconnectManager refuses every request, including the hints a page asks
+// for itself with <link rel=preconnect>, <link rel=dns-prefetch> and Link:
+// headers. Those only reach origins the page is about to load from anyway, so
+// serve them straight from the frame's network context, the way Android
+// WebView and content_shell do (components/network_hints/browser/
+// simple_network_hints_handler_impl.cc). Predictive preconnects (omnibox,
+// search engine, history, hover) still go through the PreconnectManager and
+// stay off. Off-the-record profiles keep getting no hints, as before.
+bool ServePageHintsDirectly(content::RenderFrameHost* render_frame_host) {
+  Profile* profile =
+      Profile::FromBrowserContext(render_frame_host->GetBrowserContext());
+  return profile && !profile->IsOffTheRecord() && !IsPreconnectAllowed(profile);
+}
+
+// Deletes itself when the resolve completes or the pipe closes.
+class PageHintDnsLookup : public network::ResolveHostClientBase {
+ public:
+  PageHintDnsLookup(const PageHintDnsLookup&) = delete;
+  PageHintDnsLookup& operator=(const PageHintDnsLookup&) = delete;
+
+  static void Start(content::RenderFrameHost* render_frame_host,
+                    const url::SchemeHostPort& url) {
+    auto* lookup = new PageHintDnsLookup();
+    network::mojom::ResolveHostParametersPtr parameters =
+        network::mojom::ResolveHostParameters::New();
+    parameters->initial_priority = net::RequestPriority::IDLE;
+    parameters->is_speculative = true;
+    parameters->network_restrictions_id =
+        render_frame_host->GetNetworkRestrictionsID();
+    render_frame_host->GetProcess()
+        ->GetStoragePartition()
+        ->GetNetworkContext()
+        ->ResolveHost(network::mojom::HostResolverHost::NewSchemeHostPort(url),
+                      GetPendingNetworkAnonymizationKey(render_frame_host),
+                      std::move(parameters),
+                      lookup->receiver_.BindNewPipeAndPassRemote());
+    lookup->receiver_.set_disconnect_handler(
+        base::BindOnce(&PageHintDnsLookup::Done, base::Unretained(lookup)));
+  }
+
+ private:
+  PageHintDnsLookup() = default;
+  ~PageHintDnsLookup() override = default;
+
+  // network::mojom::ResolveHostClient:
+  void OnComplete(
+      int result,
+      const net::ResolveErrorInfo& resolve_error_info,
+      const net::AddressList& resolved_addresses,
+      const net::HostResolverEndpointResults& alternative_endpoints) override {
+    Done();
+  }
+
+  void Done() { delete this; }
+
+  mojo::Receiver<network::mojom::ResolveHostClient> receiver_{this};
+};
+
 }  // namespace
 
