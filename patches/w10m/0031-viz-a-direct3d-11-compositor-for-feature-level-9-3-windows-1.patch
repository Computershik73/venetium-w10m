@@ -0,0 +1,83 @@
+// Copyright 2026 The Venetium-W10M Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+//
+// The shaders of W10mD3D11Painter: one vertex shader and five pixel shaders
+// for Direct3D feature level 9_3. Compiled offline into
+// w10m_d3d11_shaders.h by w10m_d3d11_shaders.py (the command lines are in
+// both); nothing is compiled on the phone.
+//
+// A vertex arrives finished: the CPU has transformed, snapped and clipped
+// the quad, so there are no constant buffers at all, and everything a pixel
+// needs comes with the vertices. The pixel shaders do not declare
+// SV_Position, which a level 9 pixel shader cannot read; the stages link by
+// register, so the vertex shader writes its TEXCOORDs first and the position
+// last.
+
+struct VertexIn {
+  float2 position : POSITION;   // clip space: x right, y up, -1..1
+  float2 uv : TEXCOORD0;        // 0..1 over the whole texture
+  float4 uv_bounds : TEXCOORD1; // min.xy, max.xy the samples stay within
+  float4 color : TEXCOORD2;     // premultiplied; multiplies the texel
+};
+
+struct VertexOut {
+  float2 uv : TEXCOORD0;
+  float4 uv_bounds : TEXCOORD1;
+  float4 color : TEXCOORD2;
+  float4 position : SV_Position;
+};
+
+struct PixelIn {
+  float2 uv : TEXCOORD0;
+  float4 uv_bounds : TEXCOORD1;
+  float4 color : TEXCOORD2;
+};
+
+Texture2D quad_texture : register(t0);
+SamplerState quad_sampler : register(s0);
+
+VertexOut QuadVS(VertexIn input) {
+  VertexOut output;
+  output.uv = input.uv;
+  output.uv_bounds = input.uv_bounds;
+  output.color = input.color;
+  // z = 0 and w = 1: inside the depth range, which cannot be switched off
+  // at this level, and no perspective.
+  output.position = float4(input.position, 0.0f, 1.0f);
+  return output;
+}
+
+// A solid colour quad.
+float4 ColorPS(PixelIn input) : SV_Target {
+  return input.color;
+}
+
+// A premultiplied BGRA or RGBA texture (the texture's format orders the
+// channels), read where the coordinate was interpolated to. For quads whose
+// samples cannot leave the texels they show: one texel a pixel, or the whole
+// texture shown, which the sampler's CLAMP keeps to. Not a dependent read,
+// which is all a level 9 device without full support for textures that are
+// not powers of two may do with one.
+float4 TexturePS(PixelIn input) : SV_Target {
+  return quad_texture.Sample(quad_sampler, input.uv) * input.color;
+}
+
+// The same for a texture whose alpha bytes mean nothing (an opaque image).
+float4 TextureOpaquePS(PixelIn input) : SV_Target {
+  return float4(quad_texture.Sample(quad_sampler, input.uv).rgb, 1.0f) *
+         input.color;
+}
+
+// A quad that shows part of its texture, filtered or scaled. The clamp is
+// Skia's strict source rectangle: no sample reads a texel outside the part
+// shown.
+float4 TextureClampPS(PixelIn input) : SV_Target {
+  float2 uv = clamp(input.uv, input.uv_bounds.xy, input.uv_bounds.zw);
+  return quad_texture.Sample(quad_sampler, uv) * input.color;
+}
+
+float4 TextureOpaqueClampPS(PixelIn input) : SV_Target {
+  float2 uv = clamp(input.uv, input.uv_bounds.xy, input.uv_bounds.zw);
+  return float4(quad_texture.Sample(quad_sampler, uv).rgb, 1.0f) * input.color;
+}
