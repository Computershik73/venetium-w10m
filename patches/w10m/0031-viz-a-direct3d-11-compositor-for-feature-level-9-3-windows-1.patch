+namespace viz {
+
+// Windows 10 Mobile (Venetium): the software renderer, with the GPU doing the
+// compositing where it can -- "the CPU draws, the GPU composites", for phones
+// whose GPU stops at Direct3D feature level 9_3.
+//
+// cc still rasters on the CPU and viz still gets tiles as software resources.
+// A frame that is nothing but tiles, textures and solid colours, moved and
+// scaled along the axes, is not drawn by Skia into the output device's
+// bitmap and uploaded whole: its resources are kept as textures on the
+// device that presents (uploaded once each), and its quads are drawn from
+// them into the swap chain's back buffer (W10mD3D11Target). Any other frame
+// is SoftwareRenderer's, as it was, so nothing is ever missing from the
+// picture. Which of the two a frame is, is decided when it begins: all of a
+// GPU frame, its present included, happens in BeginDrawingFrame(), and
+// DirectRenderer is then left with nothing to draw.
+class VIZ_SERVICE_EXPORT W10mD3D11Renderer
+    : public SoftwareRenderer,
+      public DisplayResourceProviderSoftware::W10mResourceObserver,
+      public W10mD3D11Target::Client {
+ public:
+  // Why a frame was left to the CPU: the first thing found in its way. The
+  // log counts frames by these.
+  enum class CpuReason {
+    kNone,  // not left to the CPU
+    // The run.
+    kGivenUp,
+    kBackingOff,
+    kTestFlip,
+    // The frame. More render passes than the root: by what the passes are
+    // drawn with, the most demanding first.
+    kPassBackdropFilter,
+    kPassFilter,
+    kPassMask,
+    kPassPlain,
+    kCopyRequest,
+    kRootRect,
+    kTooManyQuads,
+    kTextureBudget,
+    // A quad.
+    kMaterial,
+    kBlendMode,
+    kSortingContext,
+    kRoundedCorner,
+    kTransform2d,
+    kTransform3d,
+    // A quad's resource.
+    kTextureQuadState,
+    kNoResource,
+    kNotSoftware,
+    kLowLatency,
+    kPixelFormat,
+    kTextureSize,
+    kTexCoords,
+    kNonPow2,
+    // The device.
+    kNoTarget,
+    kNewDevice,
+    kDeviceObjects,
+    kUpload,
+    kPresent,
+    kTestFailure,
+    kTestCheck,
+    kCount
+  };
+
+  W10mD3D11Renderer(const RendererSettings* settings,
+                    const DebugRendererSettings* debug_settings,
+                    OutputSurface* output_surface,
+                    DisplayResourceProviderSoftware* resource_provider,
+                    OverlayProcessorInterface* overlay_processor,
+                    W10mD3D11Target* target);
+  W10mD3D11Renderer(const W10mD3D11Renderer&) = delete;
+  W10mD3D11Renderer& operator=(const W10mD3D11Renderer&) = delete;
+  ~W10mD3D11Renderer() override;
+
+ protected:
+  // SoftwareRenderer:
+  void BeginDrawingFrame() override;
+  void BeginDrawingRenderPass(const AggregatedRenderPass* render_pass,
+                              bool needs_clear,
+                              const gfx::Rect& render_pass_update_rect,
+                              const gfx::Size& viewport_size) override;
+  void DoDrawQuad(const DrawQuad* quad, const gfx::QuadF* draw_region) override;
+  void FinishDrawingFrame() override;
+  void DidChangeVisibility() override;
+
+ private:
+  // DisplayResourceProviderSoftware::W10mResourceObserver:
+  void OnW10mResourceGone(ResourceId id) override;
+
+  // W10mD3D11Target::Client:
+  void ReleaseD3D11Textures() override;
+
+  DisplayResourceProviderSoftware* software_provider() {
+    return static_cast<DisplayResourceProviderSoftware*>(
+        resource_provider_.get());
+  }
+
+  // The whole of a GPU frame: planned, drawn and presented. kNone if it is
+  // on screen; otherwise why the CPU draws this frame.
+  CpuReason DrawGpuFrame();
+  // Fills |vertices_|, |draws_| and |uploads_| from the root pass. No
+  // Direct3D call is made.
+  CpuReason PlanFrame(const gfx::Size& size);
+  // Which of the kPass reasons a frame of several render passes is.
+  CpuReason ClassifyRenderPasses() const;
+  CpuReason PlanQuad(const DrawQuad& quad, const gfx::Rect& viewport);
+  // What |id|'s pixels are, looked at once: null with kNone if there are
+  // none to draw.
+  CpuReason Inspect(ResourceId id, W10mD3D11Painter::Texture** texture);
+  // After BeginGpuFrame(): the device's objects, this frame's textures and
+  // vertices. Nothing has been written to the back buffer if it fails.
+  // |planned_on| is the device the plan was made on.
+  CpuReason PrepareFrame(uint32_t planned_on);
+  // No more GPU frames in this run. The embedder is told by
+  // FinishGivingUp(), outside the frame.
+  void GiveUp(const char* reason, bool for_good);
+  void FinishGivingUp();
+  // A step failed that may work later: none for a while, longer each time.
+  // If it |counts| (it was not memory, nor the device going), kMaxFailures
+  // in a row end it for the run.
+  void FailedForNow(const char* what, bool counts);
+  // Every texture, and now; with the device, everything made on it.
+  void DropTextures();
+  void DropDevice();
+  size_t TextureBudget(const gfx::Size& size) const;
+  // --vw-compositor-check: the frame the GPU drew and did not present,
+  // against the same frame as the CPU has just drawn it.
+  void CompareCheck();
+  void LogStatistics();
+
+  const raw_ptr<W10mD3D11Target> target_;
+  W10mD3D11Painter painter_;
+
+  bool given_up_ = false;
+  // Given up inside a frame: what the embedder is told once the frame is
+  // over.
+  const char* give_up_reason_ = nullptr;
+  bool give_up_for_good_ = false;
+  // This frame was drawn by the GPU: the base class has nothing to draw.
+  bool gpu_frame_ = false;
+  // The output device's bitmap has missed frames (the GPU drew them): the
+  // next frame the CPU draws is drawn whole.
+  bool bitmap_stale_ = false;
+  // Between BeginDrawingFrame and FinishDrawingFrame: resources that go are
+  // noted in |gone_| and forgotten at the end.
+  bool in_frame_ = false;
+  std::vector<ResourceId> gone_;
+  uint64_t frame_ = 0;
+  uint64_t no_gpu_before_frame_ = 0;
+  uint64_t back_off_frames_ = 0;
+  int failures_ = 0;
+  // The log has been told that the first textures are being made, and the
+  // first frame drawn: said before, for a driver that does not come back.
+  bool said_first_upload_ = false;
+  bool said_first_draw_ = false;
+  base::TimeTicks frame_start_;
+  base::TimeTicks last_gpu_frame_;
+
+  // The frame being planned.
+  gfx::AxisTransform2d target_to_device_;
+  std::vector<W10mD3D11Vertex> vertices_;
+  std::vector<W10mD3D11Draw> draws_;
+  std::vector<ResourceId> uploads_;
+  size_t needed_bytes_ = 0;
+  int antialiased_quads_ = 0;
+  int filtered_quads_ = 0;
+
+  // --vw-compositor-flip=N, --vw-compositor-fail=N, --vw-compositor-check=N.
+  const int test_flip_every_;
+  const int test_fail_every_;
+  const int test_check_every_;
+  uint64_t eligible_frames_ = 0;
+  uint64_t begun_frames_ = 0;
+  uint64_t drawn_frames_ = 0;
+  // A frame read back for the check, until the CPU has drawn it too (in the
+  // same DrawFrame, so the plan above is still that frame's).
+  std::vector<uint8_t> check_pixels_;
+  gfx::Size check_size_;
+
+  // What the log line every ten seconds says.
+  struct Statistics {
+    // Time between frames that followed each other closely.
+    base::TimeDelta animated;
+    int gpu_frames = 0;
+    // Of them: little of the screen had changed; the GPU was still at the
+    // frame before when the next began.
+    int small_frames = 0;
+    int gpu_behind = 0;
+    int cpu_frames = 0;
+    std::array<int, static_cast<size_t>(CpuReason::kCount)> reasons = {};
+    int switches_to_cpu = 0;
+    int quads = 0;
+    int antialiased_quads = 0;
+    int uploads = 0;
+    uint64_t uploaded_bytes = 0;
+    base::TimeDelta upload_time;
+    base::TimeDelta making_time;
+    base::TimeDelta longest_upload;
+    base::TimeDelta draw_time;
+    base::TimeDelta longest_draw;
+    int present_waits = 0;
+    base::TimeDelta gpu_frame_time;
+    base::TimeDelta cpu_frame_time;
+    int textures_dropped = 0;
+  };
+  Statistics statistics_;
+};
+
