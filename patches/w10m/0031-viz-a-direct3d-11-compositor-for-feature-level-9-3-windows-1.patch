@@ -0,0 +1,133 @@
+#!/usr/bin/env python3
+# Copyright 2026 The Venetium-W10M Authors
+# Use of this source code is governed by a BSD-style license that can be
+# found in the LICENSE file.
+"""Compiles w10m_d3d11_shaders.hlsl into w10m_d3d11_shaders.h.
+
+Run by hand after the HLSL changes, with the Windows SDK's fxc.exe:
+
+  python w10m_d3d11_shaders.py <fxc.exe> [<directory for fxc's listings>]
+
+for example with
+"C:/Program Files (x86)/Windows Kits/10/bin/10.0.22621.0/x64/fxc.exe".
+Not part of the build: the header is checked in, so that the build needs no
+SDK tool and the phone compiles nothing.
+
+What it runs, once for each shader (QuadVS.h and so on are temporary files):
+
+  fxc /nologo /T vs_4_0_level_9_3 /E QuadVS /O3 /Vn kW10mD3D11QuadVS
+      /Fh QuadVS.h w10m_d3d11_shaders.hlsl
+  fxc /nologo /T ps_4_0_level_9_3 /E ColorPS /O3 /Vn kW10mD3D11ColorPS
+      /Fh ColorPS.h w10m_d3d11_shaders.hlsl
+  fxc /nologo /T ps_4_0_level_9_3 /E TexturePS /O3 /Vn kW10mD3D11TexturePS
+      /Fh TexturePS.h w10m_d3d11_shaders.hlsl
+  fxc /nologo /T ps_4_0_level_9_3 /E TextureOpaquePS /O3
+      /Vn kW10mD3D11TextureOpaquePS /Fh TextureOpaquePS.h
+      w10m_d3d11_shaders.hlsl
+  fxc /nologo /T ps_4_0_level_9_3 /E TextureClampPS /O3
+      /Vn kW10mD3D11TextureClampPS /Fh TextureClampPS.h
+      w10m_d3d11_shaders.hlsl
+  fxc /nologo /T ps_4_0_level_9_3 /E TextureOpaqueClampPS /O3
+      /Vn kW10mD3D11TextureOpaqueClampPS /Fh TextureOpaqueClampPS.h
+      w10m_d3d11_shaders.hlsl
+
+With a directory for listings, /Fc <directory>/<entry>.asm is added: the
+level 9 code and its instruction count are in there.
+"""
+
+import os
+import re
+import subprocess
+import sys
+import tempfile
+
+SHADERS = [
+    # (profile, entry point, array)
+    ('vs_4_0_level_9_3', 'QuadVS', 'kW10mD3D11QuadVS'),
+    ('ps_4_0_level_9_3', 'ColorPS', 'kW10mD3D11ColorPS'),
+    ('ps_4_0_level_9_3', 'TexturePS', 'kW10mD3D11TexturePS'),
+    ('ps_4_0_level_9_3', 'TextureOpaquePS', 'kW10mD3D11TextureOpaquePS'),
+    ('ps_4_0_level_9_3', 'TextureClampPS', 'kW10mD3D11TextureClampPS'),
+    ('ps_4_0_level_9_3', 'TextureOpaqueClampPS',
+     'kW10mD3D11TextureOpaqueClampPS'),
+]
+
+HEAD = '''// Copyright 2026 The Venetium-W10M Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+//
+// Generated by w10m_d3d11_shaders.py from w10m_d3d11_shaders.hlsl; do not
+// edit. Each array is the bytecode fxc writes for
+//   fxc /nologo /T <profile> /E <entry> /O3 /Vn <array> /Fh <file>
+//       w10m_d3d11_shaders.hlsl
+// with the profile and the entry point named above the array.
+
+#ifndef COMPONENTS_VIZ_SERVICE_DISPLAY_W10M_D3D11_SHADERS_H_
+#define COMPONENTS_VIZ_SERVICE_DISPLAY_W10M_D3D11_SHADERS_H_
+
+#include <stdint.h>
+
+namespace viz {
+
+// clang-format off
+'''
+
+TAIL = '''
+// clang-format on
+
+}  // namespace viz
+
+#endif  // COMPONENTS_VIZ_SERVICE_DISPLAY_W10M_D3D11_SHADERS_H_
+'''
+
+
+def Compile(fxc, hlsl, profile, entry, array, listings):
+  """Returns the shader's bytecode as a list of byte values."""
+  with tempfile.TemporaryDirectory() as temp:
+    header = os.path.join(temp, entry + '.h')
+    command = [
+        fxc, '/nologo', '/T', profile, '/E', entry, '/O3', '/Vn', array,
+        '/Fh', header
+    ]
+    if listings:
+      command += ['/Fc', os.path.join(listings, entry + '.asm')]
+    command.append(hlsl)
+    subprocess.check_call(command, stdout=subprocess.DEVNULL)
+    with open(header) as f:
+      text = f.read()
+  # fxc's listing (#if 0 ... #endif) comes first and is dropped; of the array
+  # only the numbers are kept, so that the header needs no windows.h for a
+  # BYTE and has no blanks at the ends of its lines.
+  body = text[text.index('const BYTE ' + array):]
+  code = [int(n) for n in re.findall(r'-?\d+', body[body.index('{'):])]
+  if bytes(code[:4]) != b'DXBC':
+    raise SystemExit('%s: not what fxc writes for /Fh' % entry)
+  return code
+
+
+def main():
+  if len(sys.argv) not in (2, 3):
+    raise SystemExit(__doc__)
+  fxc = sys.argv[1]
+  listings = sys.argv[2] if len(sys.argv) == 3 else None
+  if listings:
+    os.makedirs(listings, exist_ok=True)
+  here = os.path.dirname(os.path.abspath(__file__))
+  hlsl = os.path.join(here, 'w10m_d3d11_shaders.hlsl')
+  out = [HEAD]
+  for profile, entry, array in SHADERS:
+    code = Compile(fxc, hlsl, profile, entry, array, listings)
+    out.append('\n// %s, %s: %d bytes.\n' % (profile, entry, len(code)))
+    out.append('inline constexpr uint8_t %s[] = {\n' % array)
+    for i in range(0, len(code), 12):
+      out.append('    %s,\n' % ', '.join('%3d' % b for b in code[i:i + 12]))
+    out.append('};\n')
+    print('%s %s: %d bytes' % (profile, entry, len(code)))
+  out.append(TAIL)
+  with open(os.path.join(here, 'w10m_d3d11_shaders.h'), 'w',
+            newline='\n') as f:
+    f.write(''.join(out))
+
+
+if __name__ == '__main__':
+  main()
