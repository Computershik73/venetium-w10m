+// Copyright 2026 The Venetium-W10M Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "components/viz/service/display/w10m_d3d11_renderer.h"
+
+#if defined(VENETIUM_W10M)
+
+#include <algorithm>
+#include <array>
+#include <bit>
+#include <cmath>
+#include <iterator>
+#include <string>
+#include <utility>
+
+#include "base/command_line.h"
+#include "base/logging.h"
+#include "base/strings/string_number_conversions.h"
+#include "base/strings/stringprintf.h"
+#include "cc/base/math_util.h"
+#include "components/viz/common/display/renderer_settings.h"
+#include "components/viz/common/quads/aggregated_render_pass.h"
+#include "components/viz/common/quads/aggregated_render_pass_draw_quad.h"
+#include "components/viz/common/quads/draw_quad.h"
+#include "components/viz/common/quads/shared_quad_state.h"
+#include "components/viz/common/quads/solid_color_draw_quad.h"
+#include "components/viz/common/quads/texture_draw_quad.h"
+#include "components/viz/common/quads/tile_draw_quad.h"
+#include "components/viz/service/display/output_surface.h"
+#include "components/viz/service/display/renderer_utils.h"
+#include "components/viz/service/display/software_output_device.h"
+#include "third_party/skia/include/core/SkBitmap.h"
+#include "third_party/skia/include/core/SkImage.h"
+#include "third_party/skia/include/core/SkMatrix.h"
+#include "third_party/skia/include/core/SkPixmap.h"
+#include "third_party/skia/include/core/SkPoint.h"
+#include "third_party/skia/include/core/SkRect.h"
+#include "ui/gfx/geometry/rect_f.h"
+#include "ui/gfx/geometry/skia_conversions.h"
+#include "ui/gfx/geometry/transform.h"
+
+namespace viz {
+
+namespace {
+
+// Steps that failed for a reason other than memory or the device going: how
+// many in a row end it for the run. And how many frames the CPU draws after
+// any failure before the GPU is tried again: this many the first time, twice
+// as many each time after, up to the most.
+constexpr int kMaxFailures = 3;
+constexpr uint64_t kBackOffFrames = 60;
+constexpr uint64_t kMaxBackOffFrames = 1800;
+
+// The log line: one for every ten seconds of animation, which is time
+// between frames that follow each other closely. A page standing still draws
+// nothing, and that time is not counted.
+constexpr base::TimeDelta kStatisticsPeriod = base::Seconds(10);
+constexpr base::TimeDelta kLongestAnimationGap = base::Milliseconds(250);
+// Textures nothing has been drawn from for this long, with the CPU drawing
+// frames all the while, are let go: a screenful is uploaded again in a frame.
+constexpr base::TimeDelta kIdleTextures = base::Seconds(2);
+// A present that stood: the frame before it had not been shown yet.
+constexpr base::TimeDelta kPresentWait = base::Milliseconds(4);
+
+// What the textures may take: four screens of pixels, within these.
+constexpr size_t kMinTextureBudget = 16u << 20;
+constexpr size_t kMaxTextureBudget = 64u << 20;
+
+// How far from one texel a pixel a quad may be and still be sampled as it
+// is, unfiltered: Skia's filter would give the same bytes. Also how far
+// texture coordinates may stray beyond the texture.
+constexpr double kAligned = 1.0 / 1024;
+
+// A rectangle with an edge further out than this Skia does not fill as a
+// rectangle but as a path (SkRectPriv::FitsInFixed in Draw::drawRect), which
+// places its edges another way.
+constexpr float kSkiaRectLimit = 32767.0f;
+
+// In the order of CpuReason.
+const char* const kReasonNames[] = {
+    "",
+    "given up",
+    "waiting after a failure",
+    "test",
+    "render pass with a backdrop filter",
+    "render pass with a filter",
+    "render pass with a mask",
+    "render passes, nothing more",
+    "copy request",
+    "root pass rect",
+    "too many quads",
+    "texture budget",
+    "quad material",
+    "blend mode",
+    "3D sorting",
+    "rounded corner",
+    "rotated or skewed",
+    "3D transform",
+    "texture quad state",
+    "resource missing",
+    "not a software resource",
+    "low latency canvas",
+    "pixel format",
+    "texture size",
+    "texture coordinates",
+    "texture not a power of two",
+    "no swap chain",
+    "new device",
+    "device objects",
+    "upload",
+    "present",
+    "test failure",
+    "test check",
+};
+static_assert(std::size(kReasonNames) ==
+              static_cast<size_t>(W10mD3D11Renderer::CpuReason::kCount));
+
+// --name=N from the engine's switches; 0 without it.
+int TestSwitch(const char* name) {
+  int value = 0;
+  base::StringToInt(
+      base::CommandLine::ForCurrentProcess()->GetSwitchValueASCII(name),
+      &value);
+  return std::max(value, 0);
+}
+
+bool NearInteger(double value) {
+  return std::abs(value - std::round(value)) <= kAligned;
+}
+
+// Into 0..1; what is not a number is 0.
+float Unit(float value) {
+  return value > 0.0f ? std::min(value, 1.0f) : 0.0f;
+}
+
+bool IsPowerOfTwo(int value) {
+  return value > 0 && std::has_single_bit(static_cast<uint32_t>(value));
+}
+
+}  // namespace
+
+W10mD3D11Renderer::W10mD3D11Renderer(
+    const RendererSettings* settings,
+    const DebugRendererSettings* debug_settings,
+    OutputSurface* output_surface,
+    DisplayResourceProviderSoftware* resource_provider,
+    OverlayProcessorInterface* overlay_processor,
+    W10mD3D11Target* target)
+    : SoftwareRenderer(settings,
+                       debug_settings,
+                       output_surface,
+                       resource_provider,
+                       overlay_processor),
+      target_(target),
+      test_flip_every_(TestSwitch("vw-compositor-flip")),
+      test_fail_every_(TestSwitch("vw-compositor-fail")),
+      test_check_every_(TestSwitch("vw-compositor-check")) {
+  resource_provider->SetW10mResourceObserver(this);
+  target_->SetD3D11Client(this);
+  if (settings->force_antialiasing) {
+    // Every edge would be Skia's to soften.
+    GiveUp("antialiasing is forced on", /*for_good=*/false);
+    FinishGivingUp();
+  }
+}
+
+W10mD3D11Renderer::~W10mD3D11Renderer() {
+  // Both outlive this (Display destroys its renderer first), and neither is
+  // to call into what is left of it. |painter_| lets go of the device's
+  // objects after this, the device still being there.
+  target_->SetD3D11Client(nullptr);
+  software_provider()->SetW10mResourceObserver(nullptr);
+}
+
+void W10mD3D11Renderer::BeginDrawingFrame() {
+  SoftwareRenderer::BeginDrawingFrame();
+  const base::TimeTicks last_frame_start = frame_start_;
+  frame_start_ = base::TimeTicks::Now();
+  ++frame_;
+  in_frame_ = true;
+  gpu_frame_ = false;
+  if (!last_frame_start.is_null() &&
+      frame_start_ - last_frame_start < kLongestAnimationGap) {
+    statistics_.animated += frame_start_ - last_frame_start;
+  }
+  if (painter_.TakeStillDrawing()) {
+    ++statistics_.gpu_behind;
+  }
+  // A device that has gone takes what was made on it along, before the
+  // embedder makes another.
+  if (painter_.device_generation() &&
+      painter_.device_generation() != target_->GetD3D11DeviceGeneration()) {
+    DropDevice();
+  }
+
+  DrawingFrame* frame = current_frame();
+  const gfx::Rect viewport(frame->device_viewport_size);
+  const bool little_changed = frame->root_damage_rect.size().Area64() * 8 <
+                              viewport.size().Area64();
+  const CpuReason reason = DrawGpuFrame();
+  if (reason == CpuReason::kNone) {
+    gpu_frame_ = true;
+    bitmap_stale_ = true;
+    last_gpu_frame_ = frame_start_;
+    if (little_changed) {
+      ++statistics_.small_frames;
+    }
+    // On screen already: nothing is left for DirectRenderer to draw. (If it
+    // redraws the root pass all the same -- the output was reshaped, or
+    // partial swap is off -- the two overrides below draw nothing.)
+    frame->root_damage_rect = gfx::Rect();
+    return;
+  }
+  ++statistics_.cpu_frames;
+  ++statistics_.reasons[static_cast<size_t>(reason)];
+  if (bitmap_stale_) {
+    // The bitmap missed the frames the GPU drew: all of it is drawn now, and
+    // the embedder is given all of it. Every quad of the frame is there to
+    // draw it from: the aggregator leaves none out for want of damage.
+    frame->root_damage_rect = viewport;
+    ++statistics_.switches_to_cpu;
+  }
+}
+
+void W10mD3D11Renderer::BeginDrawingRenderPass(
+    const AggregatedRenderPass* render_pass,
+    bool needs_clear,
+    const gfx::Rect& render_pass_update_rect,
+    const gfx::Size& viewport_size) {
+  if (gpu_frame_) {
+    // No canvas is taken from the output device, so the base class neither
+    // draws nor ends a paint.
+    return;
+  }
+  SoftwareRenderer::BeginDrawingRenderPass(render_pass, needs_clear,
+                                           render_pass_update_rect,
+                                           viewport_size);
+}
+
+void W10mD3D11Renderer::DoDrawQuad(const DrawQuad* quad,
+                                   const gfx::QuadF* draw_region) {
+  if (gpu_frame_) {
+    return;
+  }
+  SoftwareRenderer::DoDrawQuad(quad, draw_region);
+}
+
+void W10mD3D11Renderer::FinishDrawingFrame() {
+  // A frame the CPU drew is presented in here (EndPaint). The GPU's is on
+  // screen, and there is no canvas to end.
+  SoftwareRenderer::FinishDrawingFrame();
+  const base::TimeTicks now = base::TimeTicks::Now();
+  if (!gpu_frame_) {
+    if (!check_pixels_.empty()) {
+      CompareCheck();
+    }
+    bitmap_stale_ = false;
+    statistics_.cpu_frame_time += now - frame_start_;
+    if (painter_.texture_count() && now - last_gpu_frame_ > kIdleTextures) {
+      DropTextures();
+    }
+  }
+  in_frame_ = false;
+  for (ResourceId id : gone_) {
+    painter_.Remove(id);
+  }
+  gone_.clear();
+  LogStatistics();
+}
+
+void W10mD3D11Renderer::DidChangeVisibility() {
+  if (!visible_) {
+    // Before the base class tells the output device (DiscardBackbuffer): if
+    // the embedder trims its device there, what is released after may stay.
+    DropTextures();
+  }
+  SoftwareRenderer::DidChangeVisibility();
+}
+
+void W10mD3D11Renderer::OnW10mResourceGone(ResourceId id) {
+  if (in_frame_) {
+    // Does not happen (resources are returned when the draw is over); if it
+    // did, the frame's plan would still point at the texture.
+    gone_.push_back(id);
+    return;
+  }
+  painter_.Remove(id);
+}
+
+void W10mD3D11Renderer::ReleaseD3D11Textures() {
+  if (in_frame_) {
+    return;
+  }
+  DropTextures();
+}
+
+void W10mD3D11Renderer::DropTextures() {
+  statistics_.textures_dropped += painter_.texture_count();
+  painter_.DropTextures();
+  // Now, not at some later present.
+  painter_.Flush();
+}
+
+void W10mD3D11Renderer::DropDevice() {
+  statistics_.textures_dropped += painter_.texture_count();
+  painter_.DropDevice();
+}
+
+W10mD3D11Renderer::CpuReason W10mD3D11Renderer::DrawGpuFrame() {
+  if (given_up_) {
+    return CpuReason::kGivenUp;
+  }
+  if (frame_ < no_gpu_before_frame_) {
+    return CpuReason::kBackingOff;
+  }
+  const gfx::Size size = current_frame()->device_viewport_size;
+  // The plan counts on this device's limits and on the textures held now.
+  const uint32_t planned_on = painter_.device_generation();
+  CpuReason reason = PlanFrame(size);
+  if (reason != CpuReason::kNone) {
+    return reason;
+  }
+  if (test_flip_every_ && ++eligible_frames_ % test_flip_every_ == 0) {
+    return CpuReason::kTestFlip;
+  }
+
+  // From here the driver is asked for things, each of which may fail; the
+  // back buffer is first written to by Draw(), after all of them.
+  ID3D11RenderTargetView* view = nullptr;
+  switch (target_->BeginGpuFrame(size, &view)) {
+    case W10mD3D11Target::Begin::kReady:
+      break;
+    case W10mD3D11Target::Begin::kNotNow:
+      // No chain: the textures cannot be drawn from, and their room may be
+      // what the chain is refused for.
+      if (painter_.texture_count()) {
+        DropTextures();
+      }
+      return CpuReason::kNoTarget;
+    case W10mD3D11Target::Begin::kNever:
+      // The embedder has said why, and is not told what it knows.
+      given_up_ = true;
+      DropDevice();
+      LOG(WARNING) << "compositor: the embedder takes no more frames drawn "
+                      "by Direct3D 11; the CPU draws them from here";
+      return CpuReason::kGivenUp;
+  }
+  if (!view) {
+    // Not what kReady promises. Nothing to draw into, and nothing to say
+    // that there will be.
+    target_->AbandonGpuFrame();
+    FailedForNow("no view of the back buffer was given", /*counts=*/true);
+    FinishGivingUp();
+    return CpuReason::kNoTarget;
+  }
+  reason = PrepareFrame(planned_on);
+  if (reason == CpuReason::kNone && test_fail_every_ &&
+      ++begun_frames_ % test_fail_every_ == 0) {
+    reason = CpuReason::kTestFailure;
+  }
+  if (reason != CpuReason::kNone) {
+    // Nothing has been written to the back buffer. The target is told of a
+    // give-up only once its frame is over.
+    target_->AbandonGpuFrame();
+    FinishGivingUp();
+    return reason;
+  }
+
+  if (!said_first_draw_) {
+    said_first_draw_ = true;
+    LOG(WARNING) << base::StringPrintf(
+        "compositor: drawing the first frame, %d quads from %d textures",
+        static_cast<int>(draws_.size()), painter_.texture_count());
+  }
+  painter_.Draw(view, size, draws_);
+  if (test_check_every_ && ++drawn_frames_ % test_check_every_ == 0 &&
+      painter_.ReadBack(view, size, &check_pixels_)) {
+    // Not presented. The CPU draws the same frame, whole, which covers what
+    // was drawn here and is what is shown; the two are compared once it has
+    // (FinishDrawingFrame).
+    check_size_ = size;
+    target_->AbandonGpuFrame();
+    bitmap_stale_ = true;
+    return CpuReason::kTestCheck;
+  }
+  const base::TimeTicks drawn = base::TimeTicks::Now();
+  if (!target_->PresentGpuFrame()) {
+    // The embedder has said why. If it was the device, nothing of it is
+    // kept. If not, the swap chain has gone all the same, and is asked for
+    // again after a wait: nothing is drawn from the textures meanwhile, and
+    // their room may be what the next chain is refused for.
+    if (painter_.device_generation() != target_->GetD3D11DeviceGeneration()) {
+      DropDevice();
+    } else if (painter_.texture_count()) {
+      DropTextures();
+    }
+    // Drawn and not shown: the CPU's frame is a whole one, whatever the
+    // embedder does with the buffer.
+    bitmap_stale_ = true;
+    return CpuReason::kPresent;
+  }
+  const base::TimeTicks presented = base::TimeTicks::Now();
+  failures_ = 0;
+  back_off_frames_ = 0;
+  ++statistics_.gpu_frames;
+  statistics_.quads += static_cast<int>(draws_.size());
+  statistics_.antialiased_quads += antialiased_quads_;
+  statistics_.draw_time += drawn - frame_start_;
+  statistics_.longest_draw =
+      std::max(statistics_.longest_draw, drawn - frame_start_);
+  if (presented - drawn > kPresentWait) {
+    ++statistics_.present_waits;
+  }
+  statistics_.gpu_frame_time += presented - frame_start_;
+  return CpuReason::kNone;
+}
+
+W10mD3D11Renderer::CpuReason W10mD3D11Renderer::PlanFrame(
+    const gfx::Size& size) {
+  vertices_.clear();
+  draws_.clear();
+  uploads_.clear();
+  needed_bytes_ = 0;
+  antialiased_quads_ = 0;
+  filtered_quads_ = 0;
+
+  const DrawingFrame* frame = current_frame();
+  if (frame->render_passes_in_draw_order->size() != 1) {
+    return ClassifyRenderPasses();
+  }
+  const AggregatedRenderPass* root = frame->root_render_pass;
+  if (!root->copy_requests.empty()) {
+    // A copy is read from the bitmap.
+    return CpuReason::kCopyRequest;
+  }
+  if (size.IsEmpty() || root->output_rect != gfx::Rect(size)) {
+    return CpuReason::kRootRect;
+  }
+  // As DirectRenderer::DrawRenderPass has it for the root pass: all but the
+  // identity, and Skia is given it all the same.
+  target_to_device_ = CalculateTargetToDeviceTransform(root->output_rect, size);
+  const gfx::Rect viewport(size);
+  for (auto it = root->quad_list.BackToFrontBegin();
+       it != root->quad_list.BackToFrontEnd(); ++it) {
+    const DrawQuad& quad = **it;
+    // What DirectRenderer would not hand to DoDrawQuad either, in a frame
+    // that is damaged all over.
+    if (ShouldSkipQuad(quad, viewport)) {
+      continue;
+    }
+    const CpuReason reason = PlanQuad(quad, viewport);
+    if (reason != CpuReason::kNone) {
+      return reason;
+    }
+    if (draws_.size() > static_cast<size_t>(W10mD3D11Painter::kMaxQuads)) {
+      return CpuReason::kTooManyQuads;
+    }
+  }
+  if (needed_bytes_ > TextureBudget(size)) {
+    return CpuReason::kTextureBudget;
+  }
+  return CpuReason::kNone;
+}
+
+W10mD3D11Renderer::CpuReason W10mD3D11Renderer::ClassifyRenderPasses()
+    const {
+  // Only for the log: what a version that drew render passes would have to
+  // draw them with.
+  bool filter = false;
+  bool mask = false;
+  for (const auto& pass : *current_frame()->render_passes_in_draw_order) {
+    for (const DrawQuad* quad : pass->quad_list) {
+      const auto* pass_quad = quad->DynamicCast<AggregatedRenderPassDrawQuad>();
+      if (!pass_quad) {
+        continue;
+      }
+      if (!pass_quad->backdrop_filters.IsEmpty()) {
+        return CpuReason::kPassBackdropFilter;
+      }
+      filter |= !pass_quad->filters.IsEmpty();
+      mask |= !!pass_quad->mask_resource_id();
+    }
+  }
+  if (filter) {
+    return CpuReason::kPassFilter;
+  }
+  return mask ? CpuReason::kPassMask : CpuReason::kPassPlain;
+}
+
+W10mD3D11Renderer::CpuReason W10mD3D11Renderer::PlanQuad(
+    const DrawQuad& quad,
+    const gfx::Rect& viewport) {
+  const SharedQuadState* sqs = quad.shared_quad_state;
+  const bool solid = quad.material == DrawQuad::Material::kSolidColor;
+  if (!solid && quad.material != DrawQuad::Material::kTiledContent &&
+      quad.material != DrawQuad::Material::kTextureContent) {
+    return CpuReason::kMaterial;
+  }
+  if (sqs->blend_mode != SkBlendMode::kSrcOver) {
+    return CpuReason::kBlendMode;
+  }
+  if (sqs->sorting_context_id != 0) {
+    return CpuReason::kSortingContext;
+  }
+  if (ShouldApplyRoundedCorner(&quad)) {
+    return CpuReason::kRoundedCorner;
+  }
+  if (!sqs->quad_to_target_transform.IsScaleOrTranslation()) {
+    return sqs->quad_to_target_transform.Is2dTransform()
+               ? CpuReason::kTransform2d
+               : CpuReason::kTransform3d;
+  }
+  // The matrix SoftwareRenderer::DoDrawQuad gives Skia, made the same way,
+  // and the rectangle Skia fills under it, found with Skia's own calls: the
+  // quad's corners mapped in floats (Draw::drawRect), then each edge rounded
+  // to a whole pixel (SkScan::FillRect; an edge at exactly half a pixel goes
+  // up). The rasterizer is only ever given whole pixels, so its own rule for
+  // a centre on an edge, and how finely it places a vertex, never come into
+  // it.
+  gfx::Transform device_transform = sqs->quad_to_target_transform;
+  device_transform.PostConcat(target_to_device_);
+  device_transform.Flatten();
+  const SkMatrix matrix = gfx::TransformToFlattenedSkMatrix(device_transform);
+  if (!matrix.isFinite() || !matrix.isScaleTranslate()) {
+    return CpuReason::kTransform2d;
+  }
+  const SkRect visible = gfx::RectToSkRect(quad.visible_rect);
+  std::array<SkPoint, 2> corners = {SkPoint{visible.fLeft, visible.fTop},
+                                    SkPoint{visible.fRight, visible.fBottom}};
+  matrix.mapPoints(corners);
+  SkRect mapped = SkRect::MakeLTRB(corners[0].fX, corners[0].fY, corners[1].fX,
+                                   corners[1].fY);
+  mapped.sort();
+  // Written so that what is not a number fails it too.
+  if (!(mapped.fLeft >= -kSkiaRectLimit && mapped.fTop >= -kSkiaRectLimit &&
+        mapped.fRight <= kSkiaRectLimit && mapped.fBottom <= kSkiaRectLimit)) {
+    // A solid colour layer is one quad of all its bounds, however little
+    // of it shows (SolidColorLayerImpl::AppendQuads), and a long page has
+    // such layers. What Skia's path fill covers on the screen is the
+    // rectangle all the same; with no texture to place, the edges far off
+    // the screen are brought in to just outside it, which changes no pixel
+    // that is drawn.
+    if (!solid || !mapped.isFinite()) {
+      return CpuReason::kTransform2d;
+    }
+    mapped.fLeft = std::max(mapped.fLeft, -1.0f);
+    mapped.fTop = std::max(mapped.fTop, -1.0f);
+    mapped.fRight = std::min(mapped.fRight, viewport.right() + 1.0f);
+    mapped.fBottom = std::min(mapped.fBottom, viewport.bottom() + 1.0f);
+  }
+  SkIRect snapped;
+  mapped.round(&snapped);
+  // Clipped here: both are whole pixels, and no quad needs a scissor of its
+  // own.
+  gfx::Rect clip = viewport;
+  if (sqs->clip_rect) {
+    clip.Intersect(*sqs->clip_rect);
+  }
+  const int left = std::max(snapped.fLeft, clip.x());
+  const int right = std::min(snapped.fRight, clip.right());
+  const int top = std::max(snapped.fTop, clip.y());
+  const int bottom = std::min(snapped.fBottom, clip.bottom());
+  if (right <= left || bottom <= top) {
+    return CpuReason::kNone;
+  }
+
+  const bool blend = quad.ShouldDrawWithBlending();
+  W10mD3D11Draw draw;
+  draw.blend = blend;
+  float color[4] = {1.0f, 1.0f, 1.0f, 1.0f};
+  // The texture at |left|, |top|, |right|, |bottom|, and what samples stay
+  // within; as fractions of the texture.
+  double uv[4] = {0, 0, 0, 0};
+  float bounds[4] = {0, 0, 0, 0};
+
+  if (solid) {
+    const SolidColorDrawQuad* color_quad =
+        SolidColorDrawQuad::MaterialCast(&quad);
+    // SkPaint::setAlphaf(opacity * alpha), and the colour premultiplied.
+    const float alpha = Unit(sqs->opacity * color_quad->color.fA);
+    if (blend && alpha <= 0.0f) {
+      return CpuReason::kNone;
+    }
+    color[0] = Unit(color_quad->color.fR) * alpha;
+    color[1] = Unit(color_quad->color.fG) * alpha;
+    color[2] = Unit(color_quad->color.fB) * alpha;
+    color[3] = alpha;
+  } else {
+    const ResourceId id = quad.resource_id;
+    W10mD3D11Painter::Texture* texture = painter_.Find(id);
+    if (!texture) {
+      const CpuReason reason = Inspect(id, &texture);
+      if (reason != CpuReason::kNone) {
+        return reason;
+      }
+      if (!texture) {
+        return CpuReason::kNone;  // No pixels: Skia draws nothing either.
+      }
+    }
+    if (texture->unusable) {
+      return CpuReason::kPixelFormat;
+    }
+    const int width = texture->size.width();
+    const int height = texture->size.height();
+    const int max_size = painter_.max_texture_size();
+    if (width > max_size || height > max_size) {
+      return CpuReason::kTextureSize;
+    }
+
+    gfx::RectF texels;
+    bool nearest = false;
+    if (quad.material == DrawQuad::Material::kTiledContent) {
+      const TileDrawQuad* tile = TileDrawQuad::MaterialCast(&quad);
+      texels = tile->tex_coord_rect;
+      nearest = tile->nearest_neighbor;
+    } else {
+      const TextureDrawQuad* texture_quad =
+          TextureDrawQuad::MaterialCast(&quad);
+      // What SoftwareRenderer does with a flip or a colour filter of its
+      // own. The quad's other state it does not read, and neither is it
+      // read here.
+      if (texture->bottom_left ||
+          (texture_quad->background_color != SkColors::kTransparent &&
+           !texture->opaque)) {
+        return CpuReason::kTextureQuadState;
+      }
+      texels = texture_quad->GetUnnormalizedTexCoords(texture->size);
+      nearest = texture_quad->nearest_neighbor;
+    }
+    if (texels.IsEmpty()) {
+      return CpuReason::kNone;
+    }
+    // The part of the texture the visible part of the quad shows, as
+    // SoftwareRenderer works it out.
+    texels = cc::MathUtil::ScaleRectProportional(
+        texels, gfx::RectF(quad.rect), gfx::RectF(quad.visible_rect));
+    // Skia draws only as much of a quad as its texture has texels for.
+    if (texels.x() < -kAligned || texels.y() < -kAligned ||
+        texels.right() > width + kAligned ||
+        texels.bottom() > height + kAligned) {
+      return CpuReason::kTexCoords;
+    }
+    const double t0x = std::max<double>(texels.x(), 0);
+    const double t0y = std::max<double>(texels.y(), 0);
+    const double t1x = std::min<double>(texels.right(), width);
+    const double t1y = std::min<double>(texels.bottom(), height);
+    // Written so that what is not a number is nothing to draw, as for Skia.
+    if (!(t1x > t0x) || !(t1y > t0y)) {
+      return CpuReason::kNone;
+    }
+    // A pixel's centre reads the texture where the quad's own mapping puts
+    // it: linear between the edges Skia was given, not the snapped ones.
+    const bool flip_x = matrix.getScaleX() < 0;
+    const bool flip_y = matrix.getScaleY() < 0;
+    const double u_left = flip_x ? t1x : t0x;
+    const double v_top = flip_y ? t1y : t0y;
+    const double du = ((flip_x ? t0x : t1x) - u_left) /
+                      (static_cast<double>(mapped.fRight) - mapped.fLeft);
+    const double dv = ((flip_y ? t0y : t1y) - v_top) /
+                      (static_cast<double>(mapped.fBottom) - mapped.fTop);
+    uv[0] = (u_left + (left - mapped.fLeft) * du) / width;
+    uv[1] = (v_top + (top - mapped.fTop) * dv) / height;
+    uv[2] = (u_left + (right - mapped.fLeft) * du) / width;
+    uv[3] = (v_top + (bottom - mapped.fTop) * dv) / height;
+    // Skia's strict source rectangle: it cuts the whole texels the part
+    // shown touches out of the image and clamps to them
+    // (SkBitmapDevice::drawImageRect).
+    const double b0x = std::floor(t0x);
+    const double b0y = std::floor(t0y);
+    const double b1x = std::ceil(t1x);
+    const double b1y = std::ceil(t1y);
+    bounds[0] = static_cast<float>((b0x + 0.5) / width);
+    bounds[1] = static_cast<float>((b0y + 0.5) / height);
+    bounds[2] = static_cast<float>((b1x - 0.5) / width);
+    bounds[3] = static_cast<float>((b1y - 0.5) / height);
+
+    // One texel a pixel and no fraction between them: the texels as they
+    // are. Skia's filter gives the same there, and the GPU's must not differ
+    // by a rounding.
+    const bool aligned =
+        !flip_x && !flip_y &&
+        std::abs(mapped.width() - (t1x - t0x)) <= kAligned &&
+        std::abs(mapped.height() - (t1y - t0y)) <= kAligned &&
+        NearInteger(mapped.fLeft - t0x) && NearInteger(mapped.fTop - t0y);
+    // The clamp changes nothing where no sample can leave the texels shown:
+    // every sample is a texel's centre, or the texels shown are the whole
+    // texture, which the sampler keeps to.
+    const bool whole = b0x <= 0 && b0y <= 0 && b1x >= width && b1y >= height;
+    const bool clamp = !aligned && !whole;
+    if (clamp && !painter_.full_npot() &&
+        !(IsPowerOfTwo(width) && IsPowerOfTwo(height))) {
+      // This device reads such a texture only where the coordinate falls.
+      return CpuReason::kNonPow2;
+    }
+    draw.point_sampling = nearest || aligned;
+    draw.resource = id;
+    if (clamp) {
+      draw.shader = texture->opaque ? W10mD3D11Draw::Shader::kTextureOpaqueClamp
+                                    : W10mD3D11Draw::Shader::kTextureClamp;
+    } else {
+      draw.shader = texture->opaque ? W10mD3D11Draw::Shader::kTextureOpaque
+                                    : W10mD3D11Draw::Shader::kTexture;
+    }
+    if (blend) {
+      // SkPaint::setAlpha(opacity * 255): eight bits, cut off.
+      const float alpha = static_cast<int>(Unit(sqs->opacity) * 255) / 255.0f;
+      if (alpha <= 0.0f) {
+        return CpuReason::kNone;
+      }
+      color[0] = color[1] = color[2] = color[3] = alpha;
+    }
+    if (!draw.point_sampling) {
+      ++filtered_quads_;
+    }
+    if (texture->last_used_frame != frame_) {
+      texture->last_used_frame = frame_;
+      needed_bytes_ += static_cast<size_t>(width) * height * 4;
+      if (!texture->texture) {
+        uploads_.push_back(id);
+      }
+    }
+  }
+
+  // Where Skia softens the edges and this does not: a quad that is all of
+  // its layer, not on whole pixels (SoftwareRenderer::DoDrawQuad).
+  if (settings_->allow_antialiasing && !IsScaleAndIntegerTranslate(matrix) &&
+      quad.IsLeftEdge() && quad.IsTopEdge() && quad.IsRightEdge() &&
+      quad.IsBottomEdge()) {
+    ++antialiased_quads_;
+  }
+
+  // Pixels (origin top left, y down) to clip space (y up).
+  const float x0 = static_cast<float>(left * 2.0 / viewport.width() - 1);
+  const float x1 = static_cast<float>(right * 2.0 / viewport.width() - 1);
+  const float y0 = static_cast<float>(1 - top * 2.0 / viewport.height());
+  const float y1 = static_cast<float>(1 - bottom * 2.0 / viewport.height());
+  const float u0 = static_cast<float>(uv[0]);
+  const float v0 = static_cast<float>(uv[1]);
+  const float u1 = static_cast<float>(uv[2]);
+  const float v1 = static_cast<float>(uv[3]);
+  const struct {
+    float x, y, u, v;
+  } strip[4] = {
+      {x0, y0, u0, v0}, {x1, y0, u1, v0}, {x0, y1, u0, v1}, {x1, y1, u1, v1}};
+  for (const auto& corner : strip) {
+    W10mD3D11Vertex vertex;
+    vertex.x = corner.x;
+    vertex.y = corner.y;
+    vertex.u = corner.u;
+    vertex.v = corner.v;
+    std::copy(std::begin(bounds), std::end(bounds), vertex.uv_bounds);
+    std::copy(std::begin(color), std::end(color), vertex.color);
+    vertices_.push_back(vertex);
+  }
+  draws_.push_back(draw);
+  return CpuReason::kNone;
+}
+
+W10mD3D11Renderer::CpuReason W10mD3D11Renderer::Inspect(
+    ResourceId id,
+    W10mD3D11Painter::Texture** texture) {
+  *texture = nullptr;
+  DisplayResourceProviderSoftware* provider = software_provider();
+  // Asked first, and in the one way that is not fatal for an id the provider
+  // does not know: the plan looks at quads a frame's damage might never have
+  // had the CPU draw.
+  if (!id || provider->GetMailbox(id).IsZero()) {
+    return CpuReason::kNoResource;
+  }
+  if (!provider->IsResourceSoftwareBacked(id)) {
+    return CpuReason::kNotSoftware;
+  }
+  if (provider->IsLowLatencyRendering(id)) {
+    // Its pixels may change under the same id: no copy of them is kept.
+    return CpuReason::kLowLatency;
+  }
+  W10mD3D11Painter::Texture known;
+  known.bottom_left = provider->GetOrigin(id) == kBottomLeft_GrSurfaceOrigin;
+  // Not held beyond this: a resource that is locked cannot be given back.
+  DisplayResourceProviderSoftware::ScopedReadLockSkImage lock(provider, id);
+  if (!lock.valid()) {
+    return CpuReason::kNone;
+  }
+  known.size = gfx::Size(lock.sk_image()->width(), lock.sk_image()->height());
+  SkPixmap pixels;
+  if (known.size.IsEmpty() || !lock.sk_image()->peekPixels(&pixels) ||
+      (pixels.colorType() != kBGRA_8888_SkColorType &&
+       pixels.colorType() != kRGBA_8888_SkColorType) ||
+      (pixels.alphaType() != kPremul_SkAlphaType &&
+       pixels.alphaType() != kOpaque_SkAlphaType)) {
+    known.unusable = true;
+  } else {
+    known.rgba = pixels.colorType() == kRGBA_8888_SkColorType;
+    known.opaque = pixels.alphaType() == kOpaque_SkAlphaType;
+  }
+  *texture = painter_.Insert(id, std::move(known));
+  return CpuReason::kNone;
+}
+
+W10mD3D11Renderer::CpuReason W10mD3D11Renderer::PrepareFrame(
+    uint32_t planned_on) {
+  switch (painter_.EnsureDevice(target_)) {
+    case W10mD3D11Painter::DeviceResult::kReady:
+      break;
+    case W10mD3D11Painter::DeviceResult::kFailed:
+      FailedForNow("its shaders and states could not be made",
+                   /*counts=*/false);
+      return CpuReason::kDeviceObjects;
+    case W10mD3D11Painter::DeviceResult::kFailedForGood:
+      GiveUp("a shader or a state object could not be made",
+             /*for_good=*/true);
+      return CpuReason::kDeviceObjects;
+  }
+  if (painter_.device_generation() != planned_on) {
+    // The first frame on a device, the embedder's first or one it made
+    // inside BeginGpuFrame: the plan knew neither its limits nor that the
+    // textures it counted on would be gone. The next frame is planned on it.
+    return CpuReason::kNewDevice;
+  }
+
+  // Room for this frame's textures first.
+  size_t upload_bytes = 0;
+  for (ResourceId id : uploads_) {
+    if (const W10mD3D11Painter::Texture* texture = painter_.Find(id)) {
+      upload_bytes += static_cast<size_t>(texture->size.width()) *
+                      texture->size.height() * 4;
+    }
+  }
+  const size_t budget = TextureBudget(current_frame()->device_viewport_size);
+  painter_.EvictTo(budget - std::min(budget, upload_bytes), frame_);
+  if (!uploads_.empty()) {
+    // What was let go since the last flush -- just now, or when resources
+    // went after the last frame -- is the device's until a flush: it goes
+    // before more is made, so that the budget is what is really held.
+    painter_.FlushReleased();
+  }
+
+  if (!uploads_.empty() && !said_first_upload_) {
+    said_first_upload_ = true;
+    LOG(WARNING) << base::StringPrintf(
+        "compositor: making the first %d textures",
+        static_cast<int>(uploads_.size()));
+  }
+  DisplayResourceProviderSoftware* provider = software_provider();
+  for (ResourceId id : uploads_) {
+    W10mD3D11Painter::Texture* texture = painter_.Find(id);
+    if (texture && texture->texture) {
+      continue;
+    }
+    // What is known of a resource goes when the resource does, so both are
+    // there. Asked all the same, in the way that is not fatal: the lock is.
+    if (!texture || provider->GetMailbox(id).IsZero()) {
+      FailedForNow("a texture's resource is not there", /*counts=*/false);
+      return CpuReason::kUpload;
+    }
+    const base::TimeTicks before = base::TimeTicks::Now();
+    HRESULT hr = E_FAIL;
+    base::TimeDelta making;
+    {
+      // Straight from the resource's memory, under the lock, which is not
+      // kept.
+      DisplayResourceProviderSoftware::ScopedReadLockSkImage lock(provider,
+                                                                  id);
+      SkPixmap pixels;
+      if (lock.valid() && lock.sk_image()->peekPixels(&pixels) &&
+          pixels.width() == texture->size.width() &&
+          pixels.height() == texture->size.height() &&
+          pixels.info().bytesPerPixel() == 4) {
+        hr = painter_.Upload(texture, pixels, &making);
+      }
+    }
+    if (FAILED(hr)) {
+      // Memory comes and goes on a phone, and a device that has gone is the
+      // embedder's to make again: neither says the compositor cannot work.
+      FailedForNow("a texture could not be made",
+                   /*counts=*/hr != E_OUTOFMEMORY &&
+                       !painter_.DeviceRemoved());
+      return CpuReason::kUpload;
+    }
+    const base::TimeDelta took = base::TimeTicks::Now() - before;
+    ++statistics_.uploads;
+    statistics_.uploaded_bytes += texture->bytes();
+    statistics_.upload_time += took;
+    statistics_.making_time += making;
+    statistics_.longest_upload = std::max(statistics_.longest_upload, took);
+  }
+  if (!painter_.HasTextures(draws_)) {
+    // Never a textured quad with nothing to read from.
+    FailedForNow("a texture of the frame is not there", /*counts=*/false);
+    return CpuReason::kUpload;
+  }
+  const HRESULT hr = painter_.SetVertices(vertices_);
+  if (FAILED(hr)) {
+    FailedForNow("the vertex buffer could not be written",
+                 /*counts=*/hr != E_OUTOFMEMORY && !painter_.DeviceRemoved());
+    return CpuReason::kUpload;
+  }
+  return CpuReason::kNone;
+}
+
+void W10mD3D11Renderer::GiveUp(const char* reason, bool for_good) {
+  if (given_up_) {
+    return;
+  }
+  given_up_ = true;
+  give_up_reason_ = reason;
+  give_up_for_good_ = for_good;
+}
+
+void W10mD3D11Renderer::FinishGivingUp() {
+  if (!give_up_reason_) {
+    return;
+  }
+  const char* reason = give_up_reason_;
+  give_up_reason_ = nullptr;
+  DropDevice();
+  target_->OnGpuFramesGivenUp(reason, give_up_for_good_);
+}
+
+void W10mD3D11Renderer::FailedForNow(const char* what, bool counts) {
+  // Memory, most likely: what the textures hold is given back first, and
+  // now.
+  DropTextures();
+  back_off_frames_ = back_off_frames_
+                         ? std::min(back_off_frames_ * 2, kMaxBackOffFrames)
+                         : kBackOffFrames;
+  no_gpu_before_frame_ = frame_ + back_off_frames_;
+  // Once a failure, never once a frame: the next is at least kBackOffFrames
+  // frames away.
+  LOG(WARNING) << base::StringPrintf(
+      "compositor: %s; the CPU draws the next %d frames%s", what,
+      static_cast<int>(back_off_frames_),
+      counts ? "" : " (not counted against it)");
+  if (counts && ++failures_ >= kMaxFailures) {
+    GiveUp(what, /*for_good=*/false);
+  }
+}
+
+size_t W10mD3D11Renderer::TextureBudget(const gfx::Size& size) const {
+  const size_t screens =
+      static_cast<size_t>(size.width()) * size.height() * 4 * 4;
+  return std::clamp(screens, kMinTextureBudget, kMaxTextureBudget);
+}
+
+void W10mD3D11Renderer::CompareCheck() {
+  std::vector<uint8_t> gpu;
+  gpu.swap(check_pixels_);
+  // The bitmap the CPU has just drawn the frame into, whole (N32 is BGRA
+  // here, as the back buffer is). A test's way in, for a test.
+  const SkBitmap cpu = output_surface_->software_device()->ReadbackForTesting();
+  const size_t row = static_cast<size_t>(check_size_.width()) * 4;
+  if (cpu.width() != check_size_.width() ||
+      cpu.height() != check_size_.height() || cpu.bytesPerPixel() != 4 ||
+      gpu.size() != row * check_size_.height()) {
+    return;
+  }
+  // A rounding either way is not a wrong pixel.
+  constexpr int kTolerance = 2;
+  int differing = 0;
+  int largest = 0;
+  gfx::Rect where;
+  for (int y = 0; y < cpu.height(); ++y) {
+    const uint8_t* a = gpu.data() + y * row;
+    const uint8_t* b = static_cast<const uint8_t*>(cpu.getAddr(0, y));
+    for (int x = 0; x < cpu.width(); ++x, a += 4, b += 4) {
+      // Blue, green, red; the fourth byte is not shown.
+      const int difference =
+          std::max({std::abs(a[0] - b[0]), std::abs(a[1] - b[1]),
+                    std::abs(a[2] - b[2])});
+      largest = std::max(largest, difference);
+      if (difference > kTolerance) {
+        ++differing;
+        where.Union(gfx::Rect(x, y, 1, 1));
+      }
+    }
+  }
+  LOG(WARNING) << base::StringPrintf(
+      "compositor: check: frame %d, %d quads (%d filtered, Skia antialiases "
+      "%d): %d of %d pixels differ from the CPU's by more than %d (the "
+      "largest difference %d; within %s)",
+      static_cast<int>(frame_), static_cast<int>(draws_.size()),
+      filtered_quads_, antialiased_quads_, differing,
+      cpu.width() * cpu.height(), kTolerance, largest,
+      where.ToString().c_str());
+}
+
+void W10mD3D11Renderer::LogStatistics() {
+  Statistics& s = statistics_;
+  if (s.animated < kStatisticsPeriod) {
+    return;
+  }
+  // A summary, never a line a frame: a line in the embedder's log is a write
+  // and a flush. And none once the compositor is given up and every frame
+  // is the CPU's for that: it has been said.
+  const int frames = s.gpu_frames + s.cpu_frames;
+  if (frames >= 10 &&
+      s.reasons[static_cast<size_t>(CpuReason::kGivenUp)] != frames) {
+    // The commonest reasons the CPU drew a frame, five at most.
+    std::string reasons;
+    std::array<int, static_cast<size_t>(CpuReason::kCount)> left = s.reasons;
+    for (int i = 0; i < 5; ++i) {
+      const auto top = std::max_element(left.begin(), left.end());
+      if (*top == 0) {
+        break;
+      }
+      reasons += base::StringPrintf("%s%s %d", reasons.empty() ? "" : ", ",
+                                    kReasonNames[top - left.begin()], *top);
+      *top = 0;
+    }
+    const int gpu = std::max(s.gpu_frames, 1);
+    LOG(WARNING) << base::StringPrintf(
+        "compositor: over 10 s of animation %d frames drawn by the GPU (%d "
+        "of them changed under an eighth of the screen), %d by the CPU (%s), "
+        "the CPU taking over %d times; the CPU's part of a GPU frame %.1f ms "
+        "with its present (before it %.1f ms, the longest %.1f ms; %d quads; "
+        "Present waited over 4 ms for %d; the GPU was still at the frame "
+        "before for %d), a CPU frame %.1f ms; %d textures uploaded, %.1f MB "
+        "in %.1f ms (%.1f ms of it making them), the longest %.1f ms; %d "
+        "textures held, %.1f MB (%d let go unused); %d quads Skia would have "
+        "antialiased",
+        s.gpu_frames, s.small_frames, s.cpu_frames,
+        reasons.empty() ? "none" : reasons.c_str(), s.switches_to_cpu,
+        s.gpu_frame_time.InMillisecondsF() / gpu,
+        s.draw_time.InMillisecondsF() / gpu, s.longest_draw.InMillisecondsF(),
+        s.quads / gpu, s.present_waits, s.gpu_behind,
+        s.cpu_frame_time.InMillisecondsF() / std::max(s.cpu_frames, 1),
+        s.uploads, s.uploaded_bytes / 1048576.0,
+        s.upload_time.InMillisecondsF(), s.making_time.InMillisecondsF(),
+        s.longest_upload.InMillisecondsF(), painter_.texture_count(),
+        painter_.texture_bytes() / 1048576.0, s.textures_dropped,
+        s.antialiased_quads);
+  }
+  s = Statistics();
+}
