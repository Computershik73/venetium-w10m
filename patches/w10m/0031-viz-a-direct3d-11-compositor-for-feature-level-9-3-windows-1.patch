+// Copyright 2026 The Venetium-W10M Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef COMPONENTS_VIZ_SERVICE_DISPLAY_W10M_D3D11_PAINTER_H_
+#define COMPONENTS_VIZ_SERVICE_DISPLAY_W10M_D3D11_PAINTER_H_
+
+#include <windows.h>
+
+#include <d3d11.h>
+#include <stddef.h>
+#include <stdint.h>
+#include <wrl/client.h>
+
+#include <vector>
+
+#include "base/containers/flat_map.h"
+#include "base/containers/span.h"
+#include "base/time/time.h"
+#include "components/viz/common/resources/resource_id.h"
+#include "ui/gfx/geometry/size.h"
+
+class SkPixmap;
+
+namespace viz {
+
+class W10mD3D11Target;
+
+// One corner of a quad, finished on the CPU: 48 bytes, the layout
+// w10m_d3d11_shaders.hlsl's VertexIn reads.
+struct W10mD3D11Vertex {
+  float x, y;          // clip space
+  float u, v;          // 0..1 over the texture
+  float uv_bounds[4];  // min u, min v, max u, max v
+  float color[4];      // premultiplied r, g, b, a
+};
+
+// One quad of a frame: four vertices (a triangle strip) and how they are
+// drawn. Quads are drawn in the order given, back to front.
+struct W10mD3D11Draw {
+  // In the order of W10mD3D11Painter's pixel shaders.
+  enum class Shader : uint8_t {
+    kColor,
+    // The texture read where the coordinate falls...
+    kTexture,
+    kTextureOpaque,
+    // ...or no further than the vertices' uv_bounds.
+    kTextureClamp,
+    kTextureOpaqueClamp,
+    kCount
+  };
+
+  ResourceId resource = kInvalidResourceId;  // none for kColor
+  Shader shader = Shader::kColor;
+  bool blend = false;           // premultiplied source over; else replace
+  bool point_sampling = false;  // else linear
+};
+
+// The Direct3D 11 half of W10mD3D11Renderer: what is made once per device
+// (six shaders, a vertex buffer, the state objects), the textures software
+// resources are kept in, and the drawing of a planned frame. Feature level
+// 9_3 is all it needs. Knows nothing of quads or of DirectRenderer.
+//
+// One thread, the one the device's immediate context is used on.
+class W10mD3D11Painter {
+ public:
+  // More quads than this in one frame and the CPU draws it.
+  static constexpr int kMaxQuads = 1024;
+
+  // What a resource is known to be, and its texture once it has one.
+  struct Texture {
+    Texture();
+    Texture(Texture&&);
+    Texture& operator=(Texture&&);
+    ~Texture();
+
+    gfx::Size size;
+    bool rgba = false;         // R8G8B8A8, else B8G8R8A8
+    bool opaque = false;       // the alpha bytes mean nothing
+    bool bottom_left = false;  // the resource's first row is its last
+    // These pixels cannot be a texture (their format): frames that show the
+    // resource are the CPU's.
+    bool unusable = false;
+    uint64_t last_used_frame = 0;
+    Microsoft::WRL::ComPtr<ID3D11Texture2D> texture;
+    Microsoft::WRL::ComPtr<ID3D11ShaderResourceView> view;
+
+    // What the texture takes on the device; nothing while there is none.
+    size_t bytes() const {
+      return texture ? static_cast<size_t>(size.width()) * size.height() * 4
+                     : 0;
+    }
+  };
+
+  enum class DeviceResult {
+    kReady,
+    // Could not be made this time (memory, or the device went away).
+    kFailed,
+    // A device in working order refused a shader or a state object.
+    kFailedForGood,
+  };
+
+  W10mD3D11Painter();
+  W10mD3D11Painter(const W10mD3D11Painter&) = delete;
+  W10mD3D11Painter& operator=(const W10mD3D11Painter&) = delete;
+  ~W10mD3D11Painter();
+
+  // Inside a frame begun on |target|: everything made on another device is
+  // dropped, and what drawing needs is made on this one if it is not there.
+  DeviceResult EnsureDevice(W10mD3D11Target* target);
+  // The device is another, or gone, or not to be used again: nothing made
+  // on it is kept, in the context either.
+  void DropDevice();
+  // 0 while nothing is made.
+  uint32_t device_generation() const { return generation_; }
+  // What the device takes. Until one has said, anything: a frame is never
+  // drawn on a device it was not planned on.
+  int max_texture_size() const { return max_texture_size_; }
+  // Textures whose sides are not powers of two may be read at coordinates
+  // the shader worked out (below 10_0 that is the driver's to say).
+  bool full_npot() const { return full_npot_; }
+  // The device has been removed: what failed on it says nothing.
+  bool DeviceRemoved() const;
+
+  // The textures, by resource. Pointers are good until the next Insert,
+  // Remove, EvictTo, DropTextures or DropDevice.
+  Texture* Find(ResourceId id);
+  Texture* Insert(ResourceId id, Texture texture);
+  void Remove(ResourceId id);
+  // Every texture, and what is known of the resources they were made from;
+  // only the unusable ones stay noted, which costs nothing. Flush() after it
+  // has Direct3D let the memory go now, not at the next present.
+  void DropTextures();
+  void Flush();
+  // Flush() if a texture was released since the last one. Direct3D keeps a
+  // released texture's memory until a flush: one is due before more are
+  // made, or what is held is the budget and what was released on top of it.
+  void FlushReleased();
+  // Makes |texture|'s texture from |pixels| (its size, 32 bits a pixel).
+  // S_OK, or what the device answered: |texture| is as it was. |making| is
+  // the time the texture and its view took, without the copy.
+  HRESULT Upload(Texture* texture,
+                 const SkPixmap& pixels,
+                 base::TimeDelta* making);
+  // Every textured quad of |draws| has its texture.
+  bool HasTextures(base::span<const W10mD3D11Draw> draws);
+  // Releases the textures used least recently, none used in |frame|, until
+  // |budget| bytes or fewer are held.
+  void EvictTo(size_t budget, uint64_t frame);
+  size_t texture_bytes() const { return texture_bytes_; }
+  int texture_count() const { return texture_count_; }
+
+  // A frame, after EnsureDevice() and every Upload() it needs. SetVertices
+  // may fail (the buffer could not be mapped); Draw cannot, and is the first
+  // thing to write to |view|: it clears it whole, then draws |draws|, quad i
+  // from vertices 4i..4i+3 of the last SetVertices().
+  HRESULT SetVertices(base::span<const W10mD3D11Vertex> vertices);
+  void Draw(ID3D11RenderTargetView* view,
+            const gfx::Size& size,
+            base::span<const W10mD3D11Draw> draws);
+  // Once after a Draw(), when the next frame begins: the GPU had not
+  // finished that frame yet. Never waits. False when it cannot be told.
+  bool TakeStillDrawing();
+
+  // For --vw-compositor-check: what was drawn into |view|, as BGRA rows of
+  // |size|, read back through a staging texture (which waits for the GPU).
+  // False if it could not be read.
+  bool ReadBack(ID3D11RenderTargetView* view,
+                const gfx::Size& size,
+                std::vector<uint8_t>* pixels);
+
+ private:
+  static constexpr int kShaders =
+      static_cast<int>(W10mD3D11Draw::Shader::kCount);
+
+  Microsoft::WRL::ComPtr<ID3D11Device> device_;
+  Microsoft::WRL::ComPtr<ID3D11DeviceContext> context_;
+  uint32_t generation_ = 0;
+  int max_texture_size_ = D3D11_REQ_TEXTURE2D_U_OR_V_DIMENSION;
+  bool full_npot_ = true;
+
+  Microsoft::WRL::ComPtr<ID3D11VertexShader> vertex_shader_;
+  Microsoft::WRL::ComPtr<ID3D11PixelShader> pixel_shaders_[kShaders];
+  Microsoft::WRL::ComPtr<ID3D11InputLayout> layout_;
+  Microsoft::WRL::ComPtr<ID3D11Buffer> vertices_;
+  // The vertex buffer is a ring: where the next frame's vertices go, and
+  // where this frame's are.
+  UINT next_vertex_ = 0;
+  UINT first_vertex_ = 0;
+  Microsoft::WRL::ComPtr<ID3D11BlendState> blend_[2];  // replace, source over
+  Microsoft::WRL::ComPtr<ID3D11RasterizerState> rasterizer_;
+  Microsoft::WRL::ComPtr<ID3D11DepthStencilState> no_depth_;
+  Microsoft::WRL::ComPtr<ID3D11SamplerState> samplers_[2];  // linear, point
+  // Ended after a frame's last draw; null if the device has none to give.
+  Microsoft::WRL::ComPtr<ID3D11Query> frame_done_;
+  bool frame_done_asked_ = false;
+
+  base::flat_map<ResourceId, Texture> textures_;
+  size_t texture_bytes_ = 0;
+  int texture_count_ = 0;
+  // A texture was released, and the context not flushed since.
+  bool released_ = false;
+};
+
+}  // namespace viz
+
+#endif  // COMPONENTS_VIZ_SERVICE_DISPLAY_W10M_D3D11_PAINTER_H_
