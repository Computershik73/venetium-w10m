 namespace subresource_filter {
 
+#if defined(VENETIUM_W10M)
+namespace {
+
+// Windows 10 Mobile: what the built-in ad blocker (Venetium 0059) did, in the
+// log: the first request it blocked, then, at most once a minute (with the
+// next request checked), how many it checked and blocked since, and which
+// hosts it blocked most.
+void W10mNoteLoad(const GURL& url, bool blocked) {
+  struct Counts {
+    base::Lock lock;
+    base::TimeTicks since;
+    int checked = 0;
+    int blocked = 0;
+    int blocked_ever = 0;
+    base::flat_map<std::string, int> hosts;
+  };
+  static base::NoDestructor<Counts> counts;
+  base::AutoLock hold(counts->lock);
+  const base::TimeTicks now = base::TimeTicks::Now();
+  if (counts->since.is_null()) {
+    counts->since = now;
+  }
+  ++counts->checked;
+  if (blocked) {
+    ++counts->blocked;
+    if (++counts->blocked_ever == 1) {
+      LOG(WARNING) << "ad blocker: the first request blocked, to "
+                   << url.host() << " (" << counts->checked
+                   << " checked so far)";
+    }
+    if (counts->hosts.size() < 200) {
+      ++counts->hosts[url.host()];
+    }
+  }
+  const base::TimeDelta window = now - counts->since;
+  if (window < base::Seconds(60)) {
+    return;
+  }
+  std::vector<std::pair<int, std::string>> top;
+  for (const auto& [host, n] : counts->hosts) {
+    top.emplace_back(n, host);
+  }
+  std::sort(top.begin(), top.end(), std::greater<>());
+  std::string line = base::StringPrintf(
+      "ad blocker: last %d s, %d requests checked, %d blocked (%d since "
+      "start)",
+      static_cast<int>(window.InSeconds()), counts->checked, counts->blocked,
+      counts->blocked_ever);
+  for (size_t i = 0; i < top.size() && i < 5; ++i) {
+    line += base::StringPrintf("%s %s %d", i ? "," : "; most:",
+                               top[i].second.c_str(), top[i].first);
+  }
+  LOG(WARNING) << line;
+  counts->since = now;
+  counts->checked = 0;
+  counts->blocked = 0;
+  counts->hosts.clear();
+}
+
+}  // namespace
+#endif  // defined(VENETIUM_W10M)
+
