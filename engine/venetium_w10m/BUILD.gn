#
# The Venetium engine for Windows 10 Mobile: Chromium's content layer as one
# DLL with a flat C interface (capi/venetium_w10m_capi.h), loaded by the UWP
# shell. Single process, no HWND; see docs/PORTING-W10M.md.
#
# This directory is venetium-w10m/engine/venetium_w10m, linked (or copied)
# into the Chromium tree as //venetium_w10m. tools/gen.sh roots the build
# here (--root-target), so only the engine and what it needs is in the graph.

import("//build/config/win/w10m.gni")
import("//chrome/chrome_paks.gni")
import("//tools/grit/repack.gni")
import("//tools/v8_context_snapshot/v8_context_snapshot.gni")

assert(is_win && current_cpu == "arm" && is_w10m,
       "//venetium_w10m is the Windows 10 Mobile engine: target_cpu = \"arm\"" +
           " and is_w10m = true (args/w10m.gn)")

# Everything the package needs from this build.
group("venetium_w10m") {
  deps = [
    ":chrome_paks",
    ":venetium_engine",
    ":venetium_engine_pak",
  ]
}

# A look at Chrome's own browser layer (//chrome) under this target: what it
# takes to build, before the engine carries Chrome's interface.
group("chrome_probe") {
  deps = [
    "//chrome:dependencies",
    "//chrome/app:chrome_dll_resources",
    "//chrome/app:command_ids",
    "//chrome/browser:chrome_content_browser_client",
    "//chrome/browser/lifetime",
  ]
}

# Tools for packaging, built for the build machine: the ad blocker's list is
# converted from EasyList and EasyPrivacy with Chromium's ruleset_converter
# (tools/build-filters.sh).
group("vw_host_tools") {
  deps = [ "//components/subresource_filter/tools:ruleset_converter($host_toolchain)" ]
}

# A toolchain check: base, V8 and the content layer, nothing of ours.
group("probe") {
  deps = [
    "//base",
    "//content/public/browser",
    "//v8",
  ]
}

shared_library("venetium_engine") {
  output_name = "venetium_engine"
  defines = [
    "VENETIUM_W10M_ENGINE_IMPLEMENTATION",

    # Chrome's own interface is in the engine (chrome/), as well as the
    # shell's (--vw-ui=shell).
    "VW_CHROME_INTERFACE",
  ]

  sources = [
    "app/vw_content_client.cc",
    "app/vw_content_client.h",
    "app/vw_main.cc",
    "app/vw_main_delegate.cc",
    "app/vw_main_delegate.h",
    "browser/vw_browser.cc",
    "browser/vw_browser.h",
    "browser/vw_browser_client.cc",
    "browser/vw_browser_client.h",
    "browser/vw_browser_context.cc",
    "browser/vw_browser_context.h",
    "browser/vw_browser_main_parts.cc",
    "browser/vw_browser_main_parts.h",
    "browser/vw_chrome_bridge.h",
    "browser/vw_clipboard.cc",
    "browser/vw_clipboard.h",
    "browser/vw_dialogs.cc",
    "browser/vw_dialogs.h",
    "browser/vw_download_delegate.cc",
    "browser/vw_download_delegate.h",
    "browser/vw_engine.cc",
    "browser/vw_engine.h",
    "browser/vw_frame_sink.cc",
    "browser/vw_hang_watch.cc",
    "browser/vw_hang_watch.h",
    "browser/vw_frame_sink.h",
    "browser/vw_input_method.cc",
    "browser/vw_input_method.h",
    "browser/vw_interface_guard.cc",
    "browser/vw_interface_guard.h",
    "browser/vw_memory.cc",
    "browser/vw_memory.h",
    "browser/vw_panel.cc",
    "browser/vw_panel.h",
    "browser/vw_present_guard.cc",
    "browser/vw_present_guard.h",
    "browser/vw_permission_manager.cc",
    "browser/vw_permission_manager.h",
    "browser/vw_platform.cc",
    "browser/vw_platform.h",
    "browser/vw_tab.cc",
    "browser/vw_tab.h",
    "browser/vw_vsync.cc",
    "browser/vw_vsync.h",
    "browser/vw_window_manager.cc",
    "browser/vw_window_manager.h",
    "capi/venetium_w10m_capi.cc",
    "capi/venetium_w10m_capi.h",
    "common/vw_delay_load.cc",
    "common/vw_log.cc",
    "common/vw_log.h",
    "common/vw_rt_divide.cc",
    "common/vw_user_agent.cc",
    "common/vw_user_agent.h",
    "renderer/vw_renderer_client.cc",
    "renderer/vw_renderer_client.h",

    # Chrome's own interface: Chrome's startup as chrome.dll runs it (its
    # main delegate is compiled here, as it is into chrome.dll), and the
    # engine's pieces fitted to it.
    "//chrome/app/chrome_main_delegate.cc",
    "//chrome/app/chrome_main_delegate.h",
    "//chrome/app/startup_timestamps.h",
    "chrome/vw_browser_native_widget.cc",
    "chrome/vw_browser_native_widget.h",
    "chrome/vw_chrome_browser_client.cc",
    "chrome/vw_chrome_browser_client.h",
    "chrome/vw_chrome_elf.cc",
    "chrome/vw_chrome_extra_parts.cc",
    "chrome/vw_chrome_extra_parts.h",
    "chrome/vw_chrome_host.cc",
    "chrome/vw_chrome_host.h",
    "chrome/vw_chrome_main_delegate.cc",
    "chrome/vw_chrome_main_delegate.h",
    "chrome/vw_chrome_renderer_client.cc",
    "chrome/vw_chrome_renderer_client.h",
    "chrome/vw_chrome_run.cc",
    "chrome/vw_chrome_run.h",
    "chrome/vw_download_exporter.cc",
    "chrome/vw_download_exporter.h",
    "chrome/vw_select_file_dialog.cc",
    "chrome/vw_select_file_dialog.h",
    "chrome/vw_tab_grid.cc",
    "chrome/vw_tab_grid.h",
    "chrome/vw_web_apps.cc",
    "chrome/vw_web_apps.h",
  ]

  deps = [
    "//base",
    "//base:i18n",
    "//components/discardable_memory/service",
    "//components/download/public/common:public",
    "//components/headless/clipboard",
    "//components/embedder_support:user_agent",
    "//components/keyed_service/content",
    "//components/url_formatter",
    "//components/version_info",
    "//components/viz/service",
    "//content/public/app",
    "//content/public/browser",
    "//content/public/child",
    "//content/public/common",
    "//content/public/gpu",
    "//content/public/renderer",
    "//content/public/utility",
    "//net",
    "//sandbox/policy",
    "//sandbox/win:sandbox",
    "//services/network:network_service",
    "//services/network/public/cpp",
    "//skia",
    "//third_party/blink/public/common",
    "//ui/aura",
    "//ui/base",
    "//ui/base/ime",
    "//ui/display",
    "//ui/events",
    "//ui/gfx",
    "//ui/gl",
    "//gpu/config",
    "//ui/wm",
    "//url",

    # What chrome.dll is made of (//chrome:chrome_dll), less chrome_elf
    # (a DLL of its own: chrome/vw_chrome_elf.cc answers for it) and
    # install_static's secondary module (which imports from chrome_elf).
    "//chrome:dependencies",
    "//chrome/app:chrome_dll_resources",
    "//chrome/app:command_ids",
    "//chrome/app/theme:chrome_unscaled_resources",
    "//chrome/browser:chrome_content_browser_client",
    "//chrome/browser:chrome_process_singleton",
    "//chrome/browser:process_singleton",
    "//chrome/browser:startup_data",
    "//chrome/browser/lifetime",
    "//chrome/browser/win:isolated_browser_support",
    "//chrome/common:buildflags",
    "//chrome/common:version_header",
    "//chrome/common/profiler",
    "//chrome/install_static:install_static_util",
    "//components/crash/core/app",
    "//components/memory_system",
    "//components/policy:generated",
    "//components/webapps/isolated_web_apps:scheme",
    "//crypto",
    "//net:net_resources",
    "//third_party/cld_3/src/src:cld_3",
    "//third_party/wtl",
    "//ui/compositor",
    "//ui/views",
  ]

  data_deps = [
    ":chrome_paks",
    ":venetium_engine_pak",
    "//third_party/icu:icudata",
  ]
  if (use_v8_context_snapshot) {
    data_deps += [ "//tools/v8_context_snapshot" ]
  }

  # A DLL in a UWP package: the shell loads it with LoadPackagedLibrary.
  ldflags = [ "/APPCONTAINER" ]
  libs = [
    "d3d11.lib",
    "dxgi.lib",
  ]

  # Every system DLL that is not needed to load is delay-loaded: a phone's OS
  # is a subset of the desktop's, and a DLL the loader cannot find stops the
  # whole engine from loading, while a delay-loaded one only fails the call
  # that needs it -- usually one a phone never makes. Chromium's own list
  # (chrome.dll's), plus what the content layer imports beyond it.
  configs += [ "//build/config/win:delayloads" ]
  ldflags += [
    "/DELAYLOAD:cfgmgr32.dll",
    "/DELAYLOAD:crypt32.dll",
    "/DELAYLOAD:dnsapi.dll",
    "/DELAYLOAD:dwrite.dll",
    "/DELAYLOAD:mf.dll",
    "/DELAYLOAD:mfplat.dll",
    "/DELAYLOAD:mfreadwrite.dll",
    "/DELAYLOAD:powrprof.dll",
    "/DELAYLOAD:version.dll",
    "/DELAYLOAD:winmm.dll",
    "/DELAYLOAD:ws2_32.dll",
  ]
}

# Chrome's resources, for its interface: resources.pak, the 100% and 200%
# scale sets (a phone at 350% scales the 200% bitmaps; most of Chrome's
# icons are vectors) and the locales the shell speaks -- not Chrome's 228.
# Into vw_chrome/ under the build directory; the package puts them beside
# the engine DLL, where Chrome looks for them (DIR_ASSETS).
_vw_chrome_paks_dir = "$root_out_dir/vw_chrome"

chrome_repack_percent("chrome_paks_100_percent") {
  percent = "100"
  output_dir = _vw_chrome_paks_dir
}

chrome_repack_percent("chrome_paks_200_percent") {
  percent = "200"
  output_dir = _vw_chrome_paks_dir
}

chrome_extra_paks("chrome_paks_extra") {
  output_dir = _vw_chrome_paks_dir
}

chrome_repack_locales("chrome_paks_locales") {
  input_locales = [
    "en-US",
    "ru",
  ]
  output_locales = input_locales
  output_dir = "$_vw_chrome_paks_dir/locales"
}

group("chrome_paks") {
  public_deps = [
    ":chrome_paks_100_percent",
    ":chrome_paks_200_percent",
    ":chrome_paks_extra",
    ":chrome_paks_locales",
  ]
}

# The engine's resources: what content_shell.pak carries, without the test
# and internals pages, plus the 200% scale set phones need.
repack("venetium_engine_pak") {
  sources = [
    "$root_gen_dir/content/content_resources.pak",
    "$root_gen_dir/net/net_resources.pak",
    "$root_gen_dir/third_party/blink/public/resources/blink_resources.pak",
    "$root_gen_dir/third_party/blink/public/resources/blink_scaled_resources_100_percent.pak",
    "$root_gen_dir/third_party/blink/public/strings/blink_strings_en-US.pak",
    "$root_gen_dir/third_party/blink/public/strings/permission_element_generated_strings.pak",
    "$root_gen_dir/third_party/blink/public/strings/permission_element_strings_en-US.pak",
    "$root_gen_dir/ui/resources/ui_resources_100_percent.pak",
    "$root_gen_dir/ui/strings/app_locale_settings_en-US.pak",
    "$root_gen_dir/ui/strings/ax_strings_en-US.pak",
    "$root_gen_dir/ui/strings/ui_strings_en-US.pak",
  ]
  deps = [
    "//content:content_resources",
    "//net:net_resources",
    "//third_party/blink/public:resources",
    "//third_party/blink/public:scaled_resources_100_percent",
    "//third_party/blink/public/strings",
    "//third_party/blink/public/strings:permission_element_generated_strings",
    "//third_party/blink/public/strings:permission_element_strings",
    "//ui/resources",
    "//ui/strings",
  ]
  output = "$root_out_dir/venetium_engine.pak"
}
